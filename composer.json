{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        {
            "type": "package",
            "package": {
                "name": "buildingreen/rate",
                "type": "drupal-module",
                "version": "3.2",

                "dist": {
                    "type": "zip",
                    "url": "https://git.drupalcode.org/project/rate/-/archive/3.2.x/rate-3.2.x.zip"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "buildingreen/field_ipaddress",
                "type": "drupal-module",
                "version": "2.0.x-dev",

                "source": {
                    "type": "git",
                    "url": "https://git.drupalcode.org/project/field_ipaddress.git",
                    "reference": "2.0.x"
                }
            }
        },
        {
            "type": "package",
            "package": {
                "name": "buildingreen/ip_login",
                "type": "drupal-module",
                "version": "4.0.0-beta",

                "source": {
                    "type": "git",
                    "url": "https://git.drupalcode.org/project/ip_login.git",
                    "reference": "4.x"
                },
                "require": {
                    "buildingreen/field_ipaddress":  "2.0.x-dev"
                }
            }
        }


    ],
    "require": {
        "buildingreen/field_ipaddress": "2.0.x-dev",
        "buildingreen/ip_login": "^4.0@beta",
        "buildingreen/rate": "^3.2",
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^1.7",
        "dompdf/dompdf": "^3.1",
        "drupal/admin_toolbar": "^3.5",
        "drupal/base_field_override_ui": "^1.2",
        "drupal/bootstrap5": "^4.0",
        "drupal/bpmn_io": "^2.0",
        "drupal/commerce": "^3.0@beta",
        "drupal/commerce_authnet": "^1.11",
        "drupal/commerce_email": "^1.6",
        "drupal/commerce_file": "^2.2",
        "drupal/commerce_invoice": "^2.0@RC",
        "drupal/commerce_license": "^3.0",
        "drupal/commerce_pricelist": "^2.14",
        "drupal/commerce_recurring": "^1.0@RC",
        "drupal/commerce_variation_cart_form": "^1.5",
        "drupal/conditional_fields": "^4.0@alpha",
        "drupal/core-composer-scaffold": "^11.0",
        "drupal/core-project-message": "^11.0",
        "drupal/core-recommended": "^11.0",
        "drupal/ctools": "^4.1",
        "drupal/devel": "^5.3",
        "drupal/eca": "^2.0",
        "drupal/eca_cm": "^1.0",
        "drupal/eca_commerce": "^2.1",
        "drupal/eca_flag": "^2.0",
        "drupal/eca_tamper": "^2.0",
        "drupal/entity_clone": "^2.1@beta",
        "drupal/entity_print": "^2.15",
        "drupal/facets": "^2.0",
        "drupal/field_group": "^3.6",
        "drupal/field_permissions": "^1.4",
        "drupal/flag": "^4.0@beta",
        "drupal/form_mode_manager": "^3.1",
        "drupal/forum": "^1.0",
        "drupal/interval": "^1.14",
        "drupal/jquery_ui": "^1.7",
        "drupal/jquery_ui_resizable": "^2.1",
        "drupal/mail_login": "^4.0",
        "drupal/mailsystem": "^4.5",
        "drupal/masquerade": "^2.0",
        "drupal/migrate_conditions": "^2.2",
        "drupal/migrate_devel": "^3.0",
        "drupal/migrate_plus": "^6.0",
        "drupal/migrate_tools": "^6.0",
        "drupal/og": "1.x-dev@dev",
        "drupal/paragraphs": "^1.18",
        "drupal/pathauto": "^1.13",
        "drupal/quick_links": "^2.0",
        "drupal/quiz": "^7.0",
        "drupal/redirect": "^1.11",
        "drupal/reroute_email": "^2.3@RC",
        "drupal/restui": "^1.22",
        "drupal/rules": "^4.0",
        "drupal/salesforce": "^5.1",
        "drupal/search_api": "^1.37",
        "drupal/search_api_page": "^1.1",
        "drupal/smtp": "^1.4",
        "drupal/stage_file_proxy": "^3.1",
        "drupal/svg_image_field": "^2.3",
        "drupal/text_field_formatter": "^2.0",
        "drupal/token": "^1.15",
        "drupal/twig_field_value": "^2.0",
        "drupal/twig_tweak": "^3.4",
        "drupal/twigsuggest": "^2.0@RC",
        "drupal/upgrade_status": "^4.3",
        "drupal/user_email_verification": "^1.3",
        "drupal/views_bulk_operations": "^4.3",
        "drupal/views_load_more": "^2.0",
        "drupal/votingapi": "^4.0@dev",
        "drupal/webform": "^6.3@beta",
        "drush/drush": "^13.3",
        "kint-php/kint": "^6.0",
        "pantheon-se/node-composer": "^2.1",
        "pantheon-systems/drupal-integrations": "^11.1",
        "phpmailer/phpmailer": "^6.9"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "pantheon-se/node-composer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": ["@build"],
        "post-update-cmd": ["@build"],
        "build": "cd web/themes/custom/buildinggreen/front_app && ../../../../../vendor/bin/npm install && ../../../../../vendor/bin/npm run build"
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "patches": {
            "drupal/core": {
                "Add Exception for TypeError Argument must be String in \\Drupal\\Component\\Utility\\Html escape{}\n":"https://www.drupal.org/files/issues/2024-11-07/TypeError_htmlspecialchars_ArgumentNustBeTypeString_ArrayGiven-3352384-62.patch"

            },
            "buildingreen/field_ipaddress":{
               "Automated Drupal 11 compatibility fixes for field_ipaddress\n":"https://www.drupal.org/files/issues/2024-05-27/field_ipaddress.2.0.x-dev.rector.patch"}
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        },
        "pantheon-se": {
            "node-composer": {
                "node-version": "18.20.5"
            }
        }
    }
}
