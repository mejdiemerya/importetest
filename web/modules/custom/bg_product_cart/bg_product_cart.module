<?php

use Drupal\commerce_order\Entity\Order;
use Drupal\Core\Database\Database;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Link;
use Drupal\Core\Url;
use Drupal\file\Entity\File;
use Drupal\Core\Render\AttachmentsInterface;
use Drupal\user\Entity\User;

define('BG_PRODUCT_CART_BASELINE_PRICE_USER', 'googlebotIP_1');

/**
 * Implements hook_mail().
 */
function bg_product_cart_mail($key, &$message, $params)
{
  $site_mail = \Drupal::config('system.site')->get('mail');
  if (empty($site_mail)) {
    $site_mail = 'no-reply@example.com';
  }
  $site_name = \Drupal::config('system.site')->get('name');

  $options = array(
    'langcode' => $message['langcode'],
  );
//recurring_payment_declined
  switch ($key) {
    case 'notification_client_order':
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8; format=flowed; delsp=yes';
      $message['from'] = $site_name . ' <' . $site_mail . '>';
      // $message['headers']['Sender'] = 'no-reply@leeduser.com';
      // $message['headers']['Return-Path'] = 'no-reply@leeduser.com';
      // $message['headers']['From'] = 'LEEDuser <no-reply@leeduser.com>'; // Replaced by the line above
      $message['subject'] = $params['subject'];
      $message['body'][] = $params['message'];
      break;
  }
}


/**
 * @file
 * Primary module hooks for bg_product_cart module.
 */

function bg_product_cart_preprocess_commerce_product(&$variables)
{

  if ($variables['product_entity']->get('type')->target_id == "reports_courses_study_guides_web") {
    $variables['downloads'] = [];
    $priceResolv = \Drupal::service('commerce_pricelist.repository');
    $path_alias_manager = \Drupal::service('path_alias.manager');
    $account = User::load(\Drupal::currentUser()->id());
    $store_id = $variables['product_entity']->get('stores')->target_id;

    $store = \Drupal\commerce_store\Entity\Store::load($store_id);
    $formatter = \Drupal::service('commerce_price.rounder');
    $tabLinkCartVariations = [];
    $resultsOdersP = null;

    foreach ($variables['product_entity']->get('field_related_products') as $relatedProduct) {
      $resultsOdersP = getOrderByUserAndProduct($account->id(), $relatedProduct->target_id);

      if (!empty($resultsOdersP)) {

        $variables['has_purchased'] = TRUE;
        $variationItem = \Drupal\commerce_product\Entity\ProductVariation::load($relatedProduct->target_id);
        if ($variationItem->get('type')->target_id == "per_node_access") {
          $variables['purchased_nodes'] = getQuizPurchased($variationItem);
        }

      } else {
        $variables['has_purchased'] = FALSE;
        break;
      }
    }
    if (!empty($resultsOdersP)) {

      $order = Order::load($resultsOdersP);
      if (!empty($order)) {
        // Ensure getItems() returns an array and the first item exists.
        $order_items = $order->getItems();
        if (!empty($order_items) && isset($order_items[0])) {
          $purchased_entity = $order_items[0]->getPurchasedEntity();
          if ($purchased_entity && $purchased_entity->hasField('commerce_file') && !$purchased_entity->get('commerce_file')->isEmpty()) {
            foreach ($purchased_entity->get('commerce_file') as $commerce_file_item) {
              $file_data = $commerce_file_item->getValue();
              if (isset($file_data['target_id'])) {
                $file = File::load($file_data['target_id']);
                if ($file) {
                  $variables['downloads'][] = array(
                    'label' => $file_data['description'] ?? $file->label(),
                    'path' => $file->getFileUri(),
                    'id' => $file->id(),
                  );
                }
              }
            }
          }
        }
      }
    }

    $product_variations = $variables['product_entity']->getVariations();
    foreach ($product_variations as $variation) {

      $price_list_item = $priceResolv->loadItem($variation, 1, new \Drupal\commerce\Context($account, $store));

      if (!$variation->get('commerce_file')->isEmpty() && empty($variables['downloads'])) {
        foreach ($variation->get('commerce_file') as $commerce_file) {
          $file = File::load($commerce_file->getValue()['target_id']);
          $variables['downloads'][] = array(
            'label' => $commerce_file->getValue()['description'],
            'path' => $file->getFileUri(),
            'id' => $file->id(),
          );
        }
      }

      $member_price_obj = $price_list_item ? $price_list_item->getPrice() : null;
      $list_price_obj = $variation->getPrice();

      if ($member_price_obj) {
        $variables['member_price'] = $formatter->round($member_price_obj)->getNumber();
      } else {
        unset($variables['member_price']);
      }
      $variables['list_price'] = $formatter->round($list_price_obj)->getNumber();

      $tabLinkCartVariations[] = new Link(
        t('Buy it now for ') . $variables['product']['variation_price'][0]["#markup"],
        Url::fromRoute('bg_product_cart.variation_cart_add', ['pid' => $variables['product_entity']->id(), 'vid' => $variation->id()])
      );

      //check for premium member price
      $baseline_user_name = defined('BG_PRODUCT_CART_BASELINE_PRICE_USER') ? BG_PRODUCT_CART_BASELINE_PRICE_USER : 'googlebotIP_1';
      $premium_user_entities = User::loadByProperties(['name' => $baseline_user_name]);
      $premium_user = $premium_user_entities ? reset($premium_user_entities) : null;
      $pricesGooglebotip = null;

      if ($premium_user) {
        $pricesGooglebotip = $priceResolv->loadItem($variation, 1, new \Drupal\commerce\Context($premium_user, $store));
      } else {
        \Drupal::logger('bg_product_cart')->warning('Baseline user for price check "@user" not found.', ['@user' => $baseline_user_name]);
      }
      $pricesGooglebotip_price_obj = ($pricesGooglebotip && $pricesGooglebotip->getPrice()) ? $pricesGooglebotip->getPrice() : null;

      $variables['in_pricelist'] = FALSE;
      if ($member_price_obj && $pricesGooglebotip_price_obj) {
        if ($member_price_obj->lessThan($pricesGooglebotip_price_obj)) {
          $variables['in_pricelist'] = TRUE;
        }
      }

//bg PN member
      $is_pn_member = FALSE;
      if (in_array('bg_communities', $account->getRoles())) {
        $is_pn_member = TRUE;
      }

      //BG and LU premium users get same access
      $is_bg_or_lu_premium = FALSE;
      if ($account->hasPermission('access premium content') || $account->hasPermission('access LEEDuser premium content')) {
        $is_bg_or_lu_premium = TRUE;
      }

      $variables['hide_buy_button'] = FALSE;
      if (!empty($variables['product_entity']->get('field_hide_buy_button')) && $variables['product_entity']->get('field_hide_buy_button')->value == 1) {
        $variables['hide_buy_button'] = TRUE;
      }

      $resultsOders = getOrderByUserAndProduct($account->id(), $variation->id());

      if (!empty($resultsOders)
        || $account->hasPermission('administer site configuration')
        || (!empty($variables['product_entity']->get('field_free_to_pn_members')) && $variables['product_entity']->get('field_free_to_pn_members')->value == 1 && $is_pn_member)
        || (!empty($variables['product_entity']->get('field_free_to_premium_users')) && $variables['product_entity']->get('field_free_to_premium_users')->value == 1 && $is_bg_or_lu_premium)
      ) {

        $variables['has_purchased'] = TRUE;

      }
    }

    if (!empty($variables['has_purchased']) && empty($variables['purchased_nodes'])) {
      foreach ($product_variations as $variation) {
        $variables['purchased_nodes'] = getQuizPurchased($variation);
      }
    }

    if ($account->isAnonymous()) {
      $variables['has_purchased'] = false;
    }
    $variables['has_purchased'] = $variables['has_purchased'] ?? FALSE;
    $variables ['add_cart_variation'] = $tabLinkCartVariations;

  }
}

function getQuizPurchased($variation)
{
  $path_alias_manager = \Drupal::service('path_alias.manager');
  $purchased_nodes = [];
  if (!empty($variation->get('field_purcased_content'))) {
    foreach ($variation->get('field_purcased_content') as $purcased_content) {
      //
      $paragraph = \Drupal\paragraphs\Entity\Paragraph::load($purcased_content->getValue()['target_id']);
      if ($paragraph && !empty($paragraph->get('field_quiz')->target_id)) {
        $quiz = \Drupal\quiz\Entity\Quiz::load($paragraph->get('field_quiz')->target_id);
        if ($quiz) {
          $url_alias = $path_alias_manager->getAliasByPath("/quiz/" . $paragraph->get('field_quiz')->target_id);
          $purchased_nodes [] = [
            'type' => 'quiz',
            'path' => $url_alias,
            'label' => $quiz->get('title')->value,
          ];
        }
      } elseif ($paragraph && !empty($paragraph->get('field_external_quiz_link')->uri)) {
        $purchased_nodes [] = [
          'type' => 'quiz',
          'path' => $paragraph->get('field_external_quiz_link')->uri,
          'label' => $paragraph->get('field_external_quiz_link')->title,
        ];
      }
    }
  }
  return $purchased_nodes;
}

function getOrderByUserAndProduct($uid, $vid)
{
  $order_items_query = \Drupal::entityQuery('commerce_order_item')
    ->condition('uid', $uid)
    ->condition('purchased_entity', $vid)
    ->accessCheck(FALSE);
  $order_item_ids = $order_items_query->execute();

  if (empty($order_item_ids)) {
    return NULL;
  }

  $order_query = \Drupal::entityQuery('commerce_order')
    ->condition('uid', $uid)
    ->condition('state', 'completed')
    ->condition('order_items', $order_item_ids, 'IN')
    ->accessCheck(FALSE)
    ->range(0, 1);
  $order_ids = $order_query->execute();

  return !empty($order_ids) ? reset($order_ids) : NULL;
}

/**
 * Implements hook_form_alter().
 */
function bg_product_cart_form_alter(&$form, FormStateInterface $form_state, $form_id)
{

  if ($form_id == 'commerce_pricelist_commerce_product_variation_edit_form' || $form_id == 'commerce_pricelist_commerce_product_variation_add_form') {
    $form['customer_eligibility'] ['#type'] = 'checkboxes';
    $form['customer_eligibility'] ['#default_value'] = array('customer_roles', 'customers');
    $form['customer_eligibility'] ['#access'] = FALSE;
  }
}


/**
 * Implements hook_theme().
 */
function bg_product_cart_theme($existing, $type, $theme, $path)
{
  return [
    'checkout_complete_page' => [
      'variables' => ['custom_message' => NULL],
    ],
  ];
}
/**
 * Implémentation de hook_page_attachments().
 */
function bg_product_cart_page_attachments(array &$attachments) {
  $request = \Drupal::request();

  if ($request->query->get('show_modal') == '1') {
    $attachments['#attached']['library'][] = 'bg_product_cart/add_to_cart_modal';
  }
}
