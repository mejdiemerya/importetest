function custom_forums_flagging_presave(FlaggingInterface $flagging) {
  // Check if the flagging is for a taxonomy term.
  $flagged_entity = $flagging->getFlaggable();
  if ($flagged_entity instanceof Term) {
    // Determine if the operation is a flagging or unflagging operation.
    $is_flaging = $flagging->isNew();

    // Load all content (nodes) related to the flagged taxonomy term.
    $term_id = $flagged_entity->id();
    \Drupal::logger('custom_forums_flagging')->debug('@operation triggered for term ID: @term_id', ['@operation' => $is_flaging ? 'Flagging' : 'Unflagging', '@term_id' => $term_id]);

    $entity_type_manager = \Drupal::entityTypeManager();
    $related_nodes = $entity_type_manager->getStorage('node')->loadByProperties(['taxonomy_forums' => $term_id]);

    // Load the flag service.
    $flag_service = \Drupal::service('flag');
    $flag = $flag_service->getFlagById('notification');
    $account = \Drupal::currentUser();

    foreach ($related_nodes as $node) {
      \Drupal::logger('custom_forums_flagging')->debug('Processing node ID: @node_id related to term ID: @term_id', ['@node_id' => $node->id(), '@term_id' => $term_id]);

      if ($flag) {
        if ($is_flaging) {
          // Flag each related node if it's not already flagged.
          if (!$flag_service->getFlagging($flag, $node, $account)) {
            $flag_service->flag($flag, $node);
            \Drupal::logger('custom_forums_flagging')->debug('Flagged node ID: @node_id', ['@node_id' => $node->id()]);
          }
        }
        else {
          // Unflag each related node if it is flagged.
          $flagging_node = $flag_service->getFlagging($flag, $node, $account);
          if ($flagging_node) {
            $flag_service->unflag($flagging_node);
            \Drupal::logger('custom_forums_flagging')->debug('Unflagged node ID: @node_id', ['@node_id' => $node->id()]);
          }
        }
      }
    }
  }
}

function custom_forums_entity_base_field_info_alter(&$fields, EntityTypeInterface $entity_type) {
  switch ($entity_type->id()) {

    case 'node':
    case 'comment':
      $fields['uid']->setDisplayConfigurable('view', TRUE)
        ->setDisplayOptions('view', ['region' => 'hidden']);
      break;

  }
}




/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function custom_forums_preprocess_node(array &$variables) {
  // Ensure the node object is present.
  if (isset($variables['node']) && $variables['node'] instanceof NodeInterface) {
    // Check if the node has the 'taxonomy_forums' field.
    if (isset($variables['content']['taxonomy_forums']['#items'])) {
      $flag_service = \Drupal::service('flag');
      $flag = $flag_service->getFlagById('forum_notification');
      $flagged_terms = [];

      // Loop through each taxonomy term referenced in the field.
      foreach ($variables['content']['taxonomy_forums']['#items'] as $item) {
        $term = $item->entity;

        // Check if the term has been flagged.
        $is_flagged = $flag->isFlagged($term);
        // Determine the route name and parameters for flag or unflag actions.
        $route_name = $is_flagged ? 'flag.action_link_unflag' : 'flag.action_link_flag';
        $route_parameters = [
          'flag' => 'forum_notification', // Your flag ID.
          'entity_id' => $term->id(),
        ];

        // Generate the URL for flagging/unflagging.
        $link = Url::fromRoute($route_name, $route_parameters)->toString();
          $flagged_terms[] = [
            'term' => $term,
            'is_flagged' => $is_flagged,
            'flag_link' => $link, // Use the generated link.
            'action_label' => $is_flagged ? t('Unsubscribe') : t('Subscribe')];
      }
      // Pass the flagged terms information to the Twig template.
      $variables['flagged_terms'] = $flagged_terms;
    }
  }
}
function custom_forums_preprocess_page(&$variables) {
  $current_user = \Drupal::currentUser();
  $variables['is_anonymous'] = $current_user->isAnonymous();
  $variables['is_authenticated'] = $current_user->isAuthenticated();
}
/**
 * Implements hook_theme().
 */
function custom_forums_theme($existing, $type, $theme, $path) {
  return [
     'post_question_modal' => [
      'variables' => [
        'form' => NULL,
        'is_authenticated'=>NULL,
        'is_anonymous'=>NULL,
      ],
    ],
  ];
}
function getCreditFilterLabel($tid) {
  $parents = loadAllParentsModal($tid);
  \Drupal::logger('custom_module')->notice('Form state parents: @values', ['@values' => $tid]);
  $count = count($parents);
  $data = array('title' => '', 'description' => '');
  switch ($count) {
    case 1:
      // Only one item means we are looking at LEED Version.
      $data['title'] = strip_tags($parents[0]->name->value);
      break;

    case 2:
      $data['title'] = strip_tags($parents[0]->name->value);
      break;

    case 3:
      $data['title'] = strip_tags(sprintf('%s %s', $parents[1]->name->value, $parents[0]->name->value));
      $data['description'] = strip_tags($parents[0]->description->value);
      break;

    case 4:
      $data['title'] = strip_tags(sprintf('%s %s', $parents[2]->name->value, $parents[0]->name->value));
      $data['description'] = strip_tags($parents[0]->description->value);
      break;
  }
  return $data;
}

  function loadAllParentsModal($tid) {

    \Drupal::logger('custom_module')->notice('Form state parents tid: @values', ['@values' => $tid]);

    $parents = [];
    $term = Term::load($tid);

    \Drupal::logger('custom_module')->notice('Form state parents tid2: @values', ['@values' =>  json_encode($term)]);

    if (  $term) {
      $parents[] = $term;
      $n = 0;

      while (isset($parents[$n]) && $parent_id = $parents[$n]->parent->target_id) {

        if ($parent = Term::load($parent_id)) {
          $parents[] = $parent;
          $n++;
        } else {
          break;
        }
      }
    }
    \Drupal::logger('custom_module')->notice('Form state parents tid2: @values', ['@values' =>  json_encode($parents)]);


    return $parents;
  }

 function getTipsheetName($nid) {
  $query = \Drupal::entityTypeManager()->getStorage('node')->getQuery()
    ->condition('type', 'tipsheet')
    ->condition('nid', $nid)->accessCheck() // Replace 'field_credit' with the actual field linking to the credit.
    ->range(0, 1);

  $nids = $query->execute();
  if (!empty($nids)) {
    $node = \Drupal\node\Entity\Node::load(reset($nids));
    return $node->get('title')->value;
  }
  return '';
}
