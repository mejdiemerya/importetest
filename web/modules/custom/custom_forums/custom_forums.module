/**
 * Implements hook_entity_view().
 */
function custom_forums_entity_view(array &$build, \Drupal\Core\Entity\EntityInterface $entity, \Drupal\Core\Entity\Display\EntityViewDisplayInterface $display, $view_mode)
{
  // Check if the entity is a node and is of type "article".
  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'forum') {
    if ($display->getComponent('title_forum')) {
      $result = [
        'markup' => '',
        'url' => '',
        'credit' => false,
        'tipsheet' => false,
        'text' => '', // Placeholder for text
        'title' => '',
        'name'=>''
      ];
      // Initialize credit and tipsheet IDs.
      $credit_id = NULL;
      $tipsheet_id = NULL;
      $forum_id = NULL;
      $forum_name = NULL;
      if (!$entity->get('taxonomy_forums')->isEmpty()) {
        $term = $entity->get('taxonomy_forums')->entity;

        if ($term) {
          // Get the name of the taxonomy term.
          $forum_id = $term->id();
          $forum_name = $term->getName();
          $result['text'] = $forum_name;

        }
      }
      // Check if the entity has the 'field_credits'.
      if (!empty($entity->get('field_credits')->target_id)) {
        $credit_id = $entity->get('field_credits')->target_id;
        if ($credit_id) {
          $term = $entity->get('field_credits')->entity;
          $credit_name = $term->getName();
          $result['name'] = $credit_name;
          $label = getCreditFilterLabel($credit_id);
          $link = Url::fromRoute('entity.taxonomy_term.canonical', ['taxonomy_term' => $credit_id])->toString();
          $result['markup'] = sprintf('<a href="%s"><strong>%s:</strong><em>%s</em></a><br>', $link, $label['title'], $label['description']);
          $result['url'] = $link;
          $result['credit'] = true; // Set credit to true.
          $result['text'] = $label['title'];// Add text.
          $result['title'] = $label['title'] . ':' . $label['description'];

        }
      }

      // Check if the entity has the 'field_tipsheet'.
      if (!empty($entity->get('field_tipsheet')->target_id)) {
        $tipsheet_id = $entity->get('field_tipsheet')->target_id;
        $label = getTipsheetName($tipsheet_id);
        $link = Url::fromRoute('entity.node.canonical', ['node' => $tipsheet_id])->toString();
        $result['markup'] = sprintf('<a href="%s">%s</a>', $link, $label);
        $result['url'] = $link;
        $result['tipsheet'] = true;
        $result['text'] = $label;


      }

      // Add combined result to the build array.
      $build['title_forum'] = [
        '#credit_id' => $credit_id,
        '#forum_name' => $forum_name,
        '#forum_id' => $forum_id,
        '#tipsheet_id' => $tipsheet_id,
        '#markup' => $result['markup'],
        '#url' => $result['url'], // Include the URL.
        '#credit' => $result['credit'], // Include the credit flag.
        '#tipsheet' => $result['tipsheet'], // Include the tipsheet flag.
        '#text' => $result['text'], // Include the text.
        '#title' => $result['title'],
        '#name' => $result['name'],

      ];
    }
    // Render the comment count if the field is enabled.
    if ($display->getComponent('comment_count')) {
      // Load the comment count.
      if ($entity->get('comment_forum')) {
        $comment_count = $entity->get('comment_forum')->comment_count ?? 0;

        $build['comment_count'] = [
          '#markup' => $comment_count
        ];

      }
    }
    if ($display->getComponent('comment_button')) {
      $url = \Drupal\Core\Url::fromRoute('entity.node.canonical', ['node' => $entity->id()], ['fragment' => 'comment-form']);
      $build['comment_button'] = [
        '#type' => 'link',
        '#title' => t('Post a reply'),
        '#url' => $url,
        '#attributes' => [
          'class' => ['button', 'comment-button', 'btn btn-sm btn-success scroll-to-anchor'],
        ],
      ];
    }
    // Load the latest comment.
    $last_comment = \Drupal::entityTypeManager()
      ->getStorage('comment')
      ->loadByProperties([
        'entity_id' => $entity->id(),
        'entity_type' => 'node',
        'status' => 1,
      ]);

    if (!empty($last_comment)) {
      // Get the last comment.
      $last_comment = end($last_comment);

      // Get the date of the last comment.
      $last_comment_date = \Drupal::service('date.formatter')->format($last_comment->getCreatedTime(), 'custom', 'D M j, Y, g:i a');
      if ($display->getComponent('last_comment_date')) {

        $build['last_comment_date'] = [
          '#markup' => '<div class="xsmall line-snug">' . $last_comment_date . '</div>',
        ];
      }
    }


    if ($display->getComponent('user_picture')) {

      // Get the author (user entity).
      $author = $entity->getOwner();

      // Retrieve the user_picture field value.
      $user_picture_item = $author->get('user_picture')->first();

      // If the user has a profile picture.
      if ($user_picture_item && $user_picture_item->entity) {
        $user_picture_file = $user_picture_item->entity;

        // Build the render array for the user picture.
        $build['user_picture'] = [
          '#theme' => 'image',
          '#uri' => $user_picture_file->getFileUri(),
          '#attributes' => [
            'width' => '100',
            'height' => '100',
            'alt' => $user_picture_item->get('alt')->getValue() ?? '',
            'title' => $user_picture_item->get('title')->getValue() ?? '',
          ],
        ];
      }
    }
  }
  if ($entity->getEntityTypeId() === 'comment') {

    if ($display->getComponent('comment_form_button')) {

      $node = Drupal::service('current_route_match')->getParameter('node');
      if ($node) {
        $url = \Drupal\Core\Url::fromRoute('entity.node.canonical', ['node' => $node->id()], ['fragment' => 'comment-form']);
        $build['comment_form_button'] = [
          '#type' => 'link',
          '#title' => t('Post a comment'),
          '#url' => $url,
          '#attributes' => [
            'class' => ['button', 'comment-button'],
          ],
        ];
      }
    }
  }
  // Check if the entity is a user.
  if ($entity->getEntityTypeId() === 'user') {
    $role_labels = [];

    // Load and filter the user roles.
    $roles = $entity->getRoles();
    $has_guest_expert = in_array('lu_guest_expert', $roles);
    $is_admin = in_array('administrator', $roles);

    if ($entity->hasPermission('access leeduser premium content')) {
      $role_labels[] = 'LEEDuser Premium Member';
    }

    if ($has_guest_expert) {
      $role_entities = Role::loadMultiple(['lu_guest_expert']);
      foreach ($role_entities as $role) {
        $role_labels = [$role->label()];
      }
    }
    if (!$has_guest_expert && !$is_admin) {
      $role_labels = ['LEEDuser Basic Member'];
    }

    if (!empty($role_labels) && $display->getComponent('roles')) {
      $build['roles'] = [
        '#markup' => '<div class="role_labels xsmall">' . implode(', ', $role_labels) . "</div>",
      ];
    }
    $first_name = $entity->get('field_first_name')->value;
    $last_name = $entity->get('field_last_name')->value;
    $user_profile_url = \Drupal\Core\Url::fromRoute('entity.user.canonical', ['user' => $entity->id()])->toString();
    if ($first_name && $last_name) {
      if ($display->getComponent('user_name')) {
        // Add the roles to the view array.
        $build['user_name'] = [
          '#markup' => '<div class="user_name"><strong>' .
            '<a href="' . htmlspecialchars($user_profile_url) . '">' .
            htmlspecialchars($first_name) . ' ' . htmlspecialchars($last_name) .
            '</a></strong></div>',
        ];
      }

    }
  }
  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'blog') {
    // Check if the extra field should be displayed.
    if (isset($build['#view_mode']) && $build['#view_mode'] === $view_mode) {

      // Prepare the "Read more" link.
      $read_more_link = [
        '#type' => 'link',
        '#title' => t('Read more »'),
        '#url' => $entity->toUrl('canonical'),
        '#attributes' => ['class' => ['read-more-link']],

      ];

      // Prepare the "Comments" link if there are comments.
      $comment_count = $entity->get('comment')->comment_count ?? 0;
      $comments_link = NULL;
      if ($comment_count > 0) {
        $comments_link = [
          '#type' => 'link',
          '#title' => t('[@count comments]', ['@count' => $comment_count]),
          '#url' => $entity->toUrl('canonical')->setOption('fragment', 'comments'),
          '#attributes' => ['class' => ['comments-link']],

        ];
      }
// Use the renderer service to render the links.
      $renderer = \Drupal::service('renderer');
      $read_more_markup = $renderer->render($read_more_link);
      $comments_markup = $comments_link ? $renderer->render($comments_link) : '';
      // Add the links to the render array.
      if ($display->getComponent('read_more_comment_links')) {
        $build['read_more_comment_links'] = [
          '#markup' => $comments_markup . ' ' . $read_more_markup,
        ];
      }
    }
  }
  if ($entity->getEntityTypeId() == 'taxonomy_term' && $entity->bundle() == 'credit') {
    if ($display->getComponent('title_forum')) {

      $label = getCreditFilterLabel($entity->id());
      $build['title_forum'] = [
        '#markup' => '<strong>' . $label['title'] . '</strong>', // Include the text.
      ];
    }
    if ($display->getComponent('credit_checklists')) {

      $checklist_phases = _get_checklist_by_taxonomy_tid($entity->id());
      $checklists_output = '';
      $rendered_phases = []; // Array to store the names of rendered project phases

      if (!empty($checklist_phases)) {
        foreach ($checklist_phases as $checklist_phase) {
          $project_phases = $checklist_phase->get('field_project_phase')->referencedEntities();
          $project_phase = reset($project_phases); // Get the first referenced entity

          // Ensure project_phase is valid before proceeding
          if ($project_phase) {
            $phase_name = $project_phase->getName();

            // Check if the project phase has already been rendered
            if (!in_array($phase_name, $rendered_phases)) {
              // Add the phase name to the rendered list
              $rendered_phases[] = $phase_name;

              // Render the view for the project phase
              $view = \Drupal\views\Views::getView('credit_page_tab_content');
              $view->setDisplay('credit_checklist');
              $view->setArguments([$entity->id(), $project_phase->id()]); // Combine the arguments into one array
              $view->execute();
              $credit_checklists = $view->render();

              // Build the output for this phase
              $checklists_output .= '<h3>' . $phase_name . '</h3>';
              $checklists_output .= '<ul class="credit-checklist">';
              $checklists_output .= \Drupal::service('renderer')->render($credit_checklists);
              $checklists_output .= '</ul>';
            }
          }
        }
        // Embed the view programmatically.
        $build['credit_checklists'] = [
          '#markup' => $checklists_output,
          '#cache' => [
            '#max-age' => 0,
          ]
        ];
      }


    }
    if ($display->getComponent('credit_bev')) {

      // Generate a link with the 'hide sorting' label and a fragment.
      $viewpoints_output = \Drupal\Core\Link::fromTextAndUrl(
        t('hide sorting'),
        \Drupal\Core\Url::fromRoute('<current>', [], ['fragment' => 'tab-bev'])
      )->toString();
      $view = \Drupal\views\Views::getView('credit_page_tab_content');
      $view->setDisplay('credit_bev');
      $view->setArguments([$entity->id()]);
      $view->execute();
      $credit_bev = $view->render();
      // Embed the view programmatically.
      $build['credit_bev'] = [
        '#markup' => \Drupal::service('renderer')->render($credit_bev),
        '#cache' => [
          '#max-age' => 0,
        ]
      ];
    }
    if ($display->getComponent('credit_faq')) {

      // Generate a link with the 'hide sorting' label and a fragment.
      $viewpoints_output = \Drupal\Core\Link::fromTextAndUrl(
        t('hide sorting'),
        \Drupal\Core\Url::fromRoute('<current>', [], ['fragment' => 'tab-bev'])
      )->toString();
      $view = \Drupal\views\Views::getView('credit_page_tab_content');
      $view->setDisplay('credit_faq');
      $view->setArguments([$entity->id()]);
      $view->execute();
      $credit_faq = $view->render();
      // Embed the view programmatically.
      $build['credit_faq'] = [
        '#markup' => \Drupal::service('renderer')->render($credit_faq),
        '#cache' => [
          '#max-age' => 0,
        ]
      ];
    }
    if ($display->getComponent('credit_documentation_section')) {

      // Generate a link with the 'hide sorting' label and a fragment.
      $viewpoints_output = \Drupal\Core\Link::fromTextAndUrl(
        t('hide sorting'),
        \Drupal\Core\Url::fromRoute('<current>', [], ['fragment' => 'tab-bev'])
      )->toString();
      $view = \Drupal\views\Views::getView('credit_page_tab_content');
      $view->setDisplay('credit_documentation_section');
      $view->setArguments([$entity->id()]);
      $view->execute();
      $credit_documentation_section = $view->render();
      // Embed the view programmatically.
      $build['credit_documentation_section'] = [
        '#markup' => \Drupal::service('renderer')->render($credit_documentation_section),
        '#cache' => [
          '#max-age' => 0,
        ]
      ];
    }
    if ($display->getComponent('credit_resources')) {

      // Generate a link with the 'hide sorting' label and a fragment.
      $viewpoints_output = \Drupal\Core\Link::fromTextAndUrl(
        t('hide sorting'),
        \Drupal\Core\Url::fromRoute('<current>', [], ['fragment' => 'tab-bev'])
      )->toString();
      $view = \Drupal\views\Views::getView('credit_page_tab_content');
      $view->setDisplay('credit_resources');
      $view->setArguments([$entity->id()]);
      $view->execute();
      $credit_resources = $view->render();
      // Embed the view programmatically.
      $build['credit_resources'] = [
        '#markup' => \Drupal::service('renderer')->render($credit_resources),
        '#cache' => [
          '#max-age' => 0,
        ]
      ];
    }
    if ($display->getComponent('credit_addenda')) {

      // Generate a link with the 'hide sorting' label and a fragment.
      $viewpoints_output = \Drupal\Core\Link::fromTextAndUrl(
        t('hide sorting'),
        \Drupal\Core\Url::fromRoute('<current>', [], ['fragment' => 'tab-bev'])
      )->toString();
      $view = \Drupal\views\Views::getView('credit_page_tab_content');
      $view->setDisplay('credit_addenda');
      $view->setArguments([$entity->id()]);
      $view->execute();
      $credit_addenda = $view->render();
      // Embed the view programmatically.
      $build['credit_addenda'] = [
        '#markup' => \Drupal::service('renderer')->render($credit_addenda),
        '#cache' => [
          '#max-age' => 0,
        ]
      ];
    }
    if ($display->getComponent('cost_guidance')) {

      // Generate a link with the 'hide sorting' label and a fragment.
      $viewpoints_output = \Drupal\Core\Link::fromTextAndUrl(
        t('hide sorting'),
        \Drupal\Core\Url::fromRoute('<current>', [], ['fragment' => 'tab-bev'])
      )->toString();
      $view = \Drupal\views\Views::getView('credit_page_tab_content');
      $view->setDisplay('cost_guidance');
      $view->setArguments([$entity->id()]);
      $view->execute();
      $cost_guidance = $view->render();
      // Embed the view programmatically.
      $build['cost_guidance'] = [
        '#markup' => \Drupal::service('renderer')->render($cost_guidance),
        '#cache' => [
          '#max-age' => 0,
        ]
      ];
    }

  }

}

function custom_forums_entity_insert(EntityInterface $entity)
{
  if ($entity->getEntityTypeId() === 'comment' && $entity->bundle() == 'comment_forum') {
    // Load the latest comment.
    $node_related_id = $entity->get('entity_id')->getValue()[0]['target_id'];

    $node_related = Node::load($node_related_id);
    if ($node_related_id) {
      $last_comment = \Drupal::entityTypeManager()
        ->getStorage('comment')
        ->loadByProperties([
          'entity_id' => $node_related_id,
          'entity_type' => 'node',
          'status' => 1,
        ]);

      if (!empty($last_comment)) {
        // Get the last comment.
        $last_comment = end($last_comment);
        // Get the author of the last comment.
        $last_comment_author = $last_comment->getOwner();
        $node_related->set('field_last_comment_author', $last_comment_author->id());
        $node_related->save();
      }
    }
  }
}

function custom_forums_entity_delete(EntityInterface $entity)
{
  if ($entity instanceof Comment) {
    // Get the related node of the comment.
    $node_related = $entity->getCommentedEntity();

    // Get the most recent comment on this node, if any.
    $last_comment = \Drupal::entityTypeManager()
      ->getStorage('comment')
      ->loadByProperties([
        'entity_id' => $node_related->id(),
        'status' => 1,
      ]);

    // Get the last comment.
    if (!empty($last_comment)) {
      $last_comment = end($last_comment);
      $node_related->set('field_last_comment_author', $last_comment->getOwnerId());
    } else {
      // No comments remain; clear the field.
      $node_related->set('field_last_comment_author', NULL);
    }
    $node_related->save();
  }
}

function custom_forums_form_alter(&$form, &$form_state, $form_id)
{
  $current_user = \Drupal::currentUser();

  if ($form_id == 'comment_comment_forum_form') {
    $comment = $form_state->getFormObject()->getEntity();
    $entity_id = $comment->get('entity_id');

//$node=Node::load($entity_id);
    // Load the current user.
    $form['title'] = [
      '#type' => 'markup',
      '#markup' => '<h2 class="title comment-form">' . t('Post a reply ') . '</h2>',
      '#weight' => -10,
    ];
    // Load the user entity (author of the comment or the current user).
    $current_user = \Drupal\user\Entity\User::load(\Drupal::currentUser()->id());

    // Get the first and last name from custom fields, assuming they are available.
    $first_name = $current_user->get('field_first_name')->value ?? '';
    $last_name = $current_user->get('field_last_name')->value ?? '';

    // Generate the user profile URL.
    $user_profile_url = \Drupal\Core\Url::fromRoute('entity.user.canonical', [
      'user' => $current_user->id(),
    ])->toString();
    // Display the current user's name at the top of the form.
    $form['author_name_display'] = [
      '#type' => 'markup',
      '#markup' => '<p><strong>' . t('Your Name: ') . '</strong>' .
        '<a href="' . htmlspecialchars($user_profile_url) . '">' .
        htmlspecialchars($first_name) . ' ' . htmlspecialchars($last_name) .
        '</a></p>',
      '#weight' => -10,
    ];
    $form['actions']['submit']['#value'] = t('Post Comment');

    // Change the label for the comment body field to "Response".
    $form['comment_body']['widget'][0]['#title'] = t('Response');
    // Remove the Preview button if it exists.
    if (isset($form['actions']['preview'])) {
      unset($form['actions']['preview']);
    }
    if (!$current_user->hasPermission('administer site configuration')) {
      if (isset($form['comment_body']['widget'])) {
        $form['comment_body']['widget']['#after_build'][] = '_allowed_formats_remove_textarea_help';
      }
    }
  }

  if ($form_id == 'node_forum_form' || $form_id == 'node_forum_edit_form') {
    // Remove the Preview button if it exists.
    if (isset($form['actions']['preview'])) {
      unset($form['actions']['preview']);
    }
    if (isset($form['revision_log'])) {
      $form['revision_log']['#access'] = FALSE;
    }
    $form['actions']['submit']['#value'] = t('Post to forum');
    $form['#attached']['library'][] = 'core/drupal.ajax';
    $form['#attached']['library'][] = 'core/jquery';
    $form['#attached']['library'][] = 'core/drupal.dialog';
    // Add a Cancel button.
    $form['actions']['cancel'] = [
      '#type' => 'link',
      '#title' => t('Cancel'),
      '#url' => \Drupal\Core\Url::fromRoute('<front>'),
      '#attributes' => [
        'class' => [
          'button',
          'cancel',
        ],
      ],
      '#weight' => 20,
    ];
    // Get the form ID from the URL or any custom logic.
    $current_form_id = \Drupal::request()->query->get('forum_id');
    $current_credit_id = \Drupal::request()->query->get('credit_id');
    $current_tipsheet_id = \Drupal::request()->query->get('tipsheet_id');

    if ($current_form_id) {
      $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($current_form_id);

      // Ensure the form field exists in the form and assign it the value.
      if (isset($form['taxonomy_forums'])) {
        $form['taxonomy_forums']['widget'][0]['target_id']['#default_value'] = $term;
        $form['taxonomy_forums']['#access'] = FALSE;
        $form['field_credits']['#access'] = FALSE;
        $form['field_tipsheet']['#access'] = FALSE;
        $form['moderation_state']['#access'] = FALSE;
      }
      // Add  "Forum area" with a change link


      // Add the forum area field with the term name and change link
      $form['forum_area'] = [
        '#markup' => t('Forum area: @forum_name <a href="#" data-bs-toggle="modal" data-bs-target="#post-question-modal"  >[change] </a>', [
          '@forum_name' => $term->getName(),
        ]),
      ];
    }
    if ($current_credit_id) {
      $term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($current_credit_id);
      // Ensure the form field exists in the form and assign it the value.
      if (isset($form['field_credits'])) {
        $form['field_credits']['widget'][0]['target_id']['#default_value'] = $term;
        $form['taxonomy_forums']['widget'][0]['target_id']['#default_value'] = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load(getTermIdByName('Credit Forums', 'forums'));
        $form['taxonomy_forums']['#access'] = FALSE;
        $form['field_credits']['#access'] = FALSE;
        $form['field_tipsheet']['#access'] = FALSE;
        $form['moderation_state']['#access'] = FALSE;

      }
      // Add  "Forum area" with a change link
      $change_url = \Drupal\Core\Url::fromRoute('custom_forums.topic_add')->toString();

      // Add the forum area field with the term name and change link
      $form['forum_area'] = [
        '#markup' => t('Forum area: @forum_name <a href="#" data-bs-toggle="modal" data-bs-target="#post-question-modal"  >[change] </a>', [
          '@forum_name' => strip_tags($term->getDescription()),
        ]),];
    }
    if ($current_tipsheet_id) {
      $term = \Drupal::entityTypeManager()->getStorage('node')->load($current_tipsheet_id);
      // Ensure the form field exists in the form and assign it the value.
      if (isset($form['field_tipsheet'])) {
        $form['field_tipsheet']['widget'][0]['target_id']['#default_value'] = $term;
        $form['taxonomy_forums']['widget'][0]['target_id']['#default_value'] = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load(getTermIdByName('Tipsheet Forum', 'forums'));
        $form['taxonomy_forums']['#access'] = FALSE;
        $form['field_credits']['#access'] = FALSE;
        $form['moderation_state']['#access'] = FALSE;
      }

    }
    if (!$current_user->hasPermission('administer site configuration')) {
      if (isset($form['field_question']['widget'])) {
        $form['field_question']['widget']['#after_build'][] = '_allowed_formats_remove_textarea_help';
      }
    }
  }
}

function _allowed_formats_remove_textarea_help($form_element, FormStateInterface $form_state)
{

  if (isset($form_element[0]['format'])) {
    // All this stuff is needed to hide the help text.
    unset($form_element[0]['format']['guidelines']);
    unset($form_element[0]['format']['help']);
    unset($form_element[0]['format']['#type']);
    unset($form_element[0]['format']['#theme_wrappers']);
    $form_element[0]['format']['format']['#access'] = FALSE;
  }

  return $form_element;
}

function custom_forums_flagging_presave(FlaggingInterface $flagging)
{
  // Get the flagged entity.
  $flagged_entity = $flagging->getFlaggable();
  $entity_type_manager = \Drupal::entityTypeManager();
  $related_nids = [];

  // Determine the bundle and load related nodes.
  if ($flagged_entity instanceof Term) {
    $term_id = $flagged_entity->id();
    if ($flagged_entity->bundle() == 'forums') {
      $related_nids = $entity_type_manager->getStorage('node')->getQuery()
        ->condition('taxonomy_forums', $term_id)->accessCheck(false)
        ->execute();
    } elseif ($flagged_entity->bundle() == 'credit') {
      $related_nids = $entity_type_manager->getStorage('node')->getQuery()
        ->condition('field_credits', $term_id)->accessCheck(false)
        ->execute();
    }
  } elseif ($flagged_entity instanceof Node) {
    if ($flagged_entity->bundle() == 'tipsheet') {
      $related_nids = $entity_type_manager->getStorage('node')->getQuery()
        ->condition('field_tipsheet', $flagged_entity->id())->accessCheck(false)
        ->execute();
    }
  }

  if (empty($related_nids)) {
    return; // No related nodes found, exit early.
  }

  // Load the flag service.
  $flag_service = \Drupal::service('flag');
  $flag = $flag_service->getFlagById('notification');
  $account = \Drupal::currentUser();

  if (!$flag) {
    // Log a warning if the flag is not found and exit early.
    \Drupal::logger('custom_forums')->warning('Notification flag not found.');
    return;
  }

  // Process nodes in batches.
  $batch_size = 50;
  $related_nid_batches = array_chunk($related_nids, $batch_size);

  foreach ($related_nid_batches as $batch) {
    $nodes = $entity_type_manager->getStorage('node')->loadMultiple($batch);
    foreach ($nodes as $node) {
      // Only flag if the flag is applicable and not already flagged.
      if ($flag && !$flag_service->getFlagging($flag, $node, $account)) {
        try {
          $flag_service->flag($flag, $node);
        } catch (\Exception $e) {
          \Drupal::logger('custom_forums')->error('Failed to flag node ID @nid: @message', ['@nid' => $node->id(), '@message' => $e->getMessage()]);
        }
      }
    }
  }
}

function custom_forums_flagging_delete(FlaggingInterface $flagging)
{
  // Check if the flagging is for a taxonomy term.
  $flagged_entity = $flagging->getFlaggable();
  $related_nodes = [];
  $entity_type_manager = \Drupal::entityTypeManager();

  if ($flagged_entity instanceof Term) {

    if ($flagged_entity->bundle() == 'forums') {
      $related_nodes = $entity_type_manager->getStorage('node')->loadByProperties(['taxonomy_forums' => $flagged_entity->id()]);

    } elseif ($flagged_entity->bundle() == 'credit') {
      $related_nodes = $entity_type_manager->getStorage('node')->loadByProperties(['field_credits' => $flagged_entity->id()]);
    }
  }
  if ($flagged_entity instanceof Node) {
    if ($flagged_entity->bundle() == 'tipsheet') {
      $related_nodes = $entity_type_manager->getStorage('node')->loadByProperties(['field_tipsheet' => $flagged_entity->id()]);
    }
  }
  // Load the flag service and check if the node is already flagged.
  $flag_service = \Drupal::service('flag');
  $flag = $flag_service->getFlagById('notification');
  $account = \Drupal::currentUser();
  // Flag each related node if it's not already flagged.
  foreach ($related_nodes as $node) {
    if ($flag && $flag_service->getFlagging($flag, $node, $account)) {
      // Flag the node if not already flagged.
      $flag_service->unflag($flag, $node);
    }
  }
}

function custom_forums_entity_base_field_info_alter(&$fields, EntityTypeInterface $entity_type)
{
  switch ($entity_type->id()) {

    case 'node':
      $fields['created']->setDisplayConfigurable('view', TRUE)
        ->setDisplayOptions('view', ['region' => 'hidden']);
      $fields['uid']->setDisplayConfigurable('view', TRUE)
        ->setDisplayOptions('view', ['region' => 'hidden']);
      break;
    case 'comment':
      $fields['uid']->setDisplayConfigurable('view', TRUE)
        ->setDisplayOptions('view', ['region' => 'hidden']);
      break;

  }
}


/**
 * Implements hook_preprocess_HOOK() for node templates.
 */
function custom_forums_preprocess_node(array &$variables)
{
  // Ensure the node object is present and is a NodeInterface instance.
  if (isset($variables['node']) && $variables['node'] instanceof \Drupal\node\NodeInterface) {
    $flag_service = \Drupal::service('flag');

    // Initialize flagged terms array.
    $flagged_terms = [];

    // Check if the node has the 'taxonomy_forums' field.
    if ($variables['node']->hasField('taxonomy_forums') && !$variables['node']->get('taxonomy_forums')->isEmpty()) {
      $flag = $flag_service->getFlagById('forum_notification');

      foreach ($variables['content']['taxonomy_forums']['#items'] as $item) {
        $term = $item->entity;

        // Check if the term has been flagged.
        $is_flagged = $flag->isFlagged($term);
        $route_name = $is_flagged ? 'flag.action_link_unflag' : 'flag.action_link_flag';
        $route_parameters = [
          'flag' => 'forum_notification',
          'entity_id' => $term->id(),
          'view_mode' => 'default',
        ];
        // Get the current page URL for the destination parameter.
        $current_path = \Drupal::service('path.current')->getPath();
        $current_query = \Drupal::request()->query->all(); // Get query parameters from the current request.
        $destination = Url::fromUserInput($current_path, ['query' => $current_query])->toString();

        // Generate the URL for flagging/unflagging with the destination parameter.
        $link = Url::fromRoute($route_name, $route_parameters, [
          'query' => ['destination' => $destination],
        ])->toString();

        $flagged_terms = [
          'term' => $term,
          'is_flagged' => $is_flagged,
          'flag_link' => $link,
          'action_label' => $is_flagged ? t('Unsubscribe') : t('Subscribe'),
        ];
      }
    }

    // Add logic for `field_credits`.
    if ($variables['node']->hasField('field_credits') && !$variables['node']->get('field_credits')->isEmpty()) {

      $subscription_credit_flag = $flag_service->getFlagById('subscription_credit');
      $credit_id = $variables['node']->get('field_credits')->target_id;
      $variables['credit_faqs'] = _lu_content_get_credit_faqs($credit_id, 20);
      if ($credit_id) {
        $term = Term::load($credit_id);
        $is_flagged = $subscription_credit_flag->isFlagged($term);
        $route_name = $is_flagged ? 'flag.action_link_unflag' : 'flag.action_link_flag';
        $route_parameters = [
          'flag' => 'subscription_credit',
          'entity_id' => $term->id(),
          'view_mode' => 'default',

        ];
        $current_path = \Drupal::service('path.current')->getPath();
        $current_query = \Drupal::request()->query->all(); // Get query parameters from the current request.

        $destination = Url::fromUserInput($current_path, ['query' => $current_query])->toString();

        // Generate the URL for flagging/unflagging with the destination parameter.
        $link = Url::fromRoute($route_name, $route_parameters, [
          'query' => ['destination' => $destination],
        ])->toString();
        $flagged_terms = [
          'term' => $term,
          'is_flagged' => $is_flagged,
          'flag_link' => $link,
          'action_label' => $is_flagged ? t('Unsubscribe Credits') : t('Subscribe Credits'),
        ];
      }
    }
    // Add logic for `field_tipsheet`.
    if ($variables['node']->hasField('field_tipsheet') && !$variables['node']->get('field_tipsheet')->isEmpty()) {

      $subscription_tipsheet_flag = $flag_service->getFlagById('subscription_tipsheet');
      $tipsheet_id = $variables['node']->get('field_tipsheet')->target_id;
      if ($tipsheet_id) {
        $node = Node::load($tipsheet_id);
        $is_flagged = $subscription_tipsheet_flag->isFlagged($node);
        $route_name = $is_flagged ? 'flag.action_link_unflag' : 'flag.action_link_flag';
        $route_parameters = [
          'flag' => 'subscription_tipsheet',
          'entity_id' => $node->id(),
          'view_mode' => 'default',
        ];
        $current_path = \Drupal::service('path.current')->getPath();
        $current_query = \Drupal::request()->query->all(); // Get query parameters from the current request.
        $destination = Url::fromUserInput($current_path, ['query' => $current_query])->toString();

// Generate the URL for flagging/unflagging with the destination parameter.
        $link = Url::fromRoute($route_name, $route_parameters, [
          'query' => ['destination' => $destination],
        ])->toString();
        $flagged_terms = [
          'term' => $node,
          'is_flagged' => $is_flagged,
          'flag_link' => $link,
          'action_label' => $is_flagged ? t('Unsubscribe Tipsheet') : t('Subscribe Tipsheet'),
        ];

      }
    }
    $variables['#cache'] = [
      'max-age' => 0,
    ];
    // Pass the flagged terms information to the Twig template.
    $variables['flagged_terms'] = $flagged_terms;
    $currentUser = \Drupal::currentUser();

    if ($currentUser->isAnonymous() || !\Drupal::currentUser()->hasPermission('access leeduser premium content')) {

      $membership_promo_block = [
        '#theme' => 'membership_promo_block',
      ];

      $variables['membership_promo_block'] = \Drupal::service('renderer')->render($membership_promo_block);
    }


  }
}

function custom_forums_preprocess_page(&$variables)
{
  $current_user = \Drupal::currentUser();
  $variables['is_anonymous'] = $current_user->isAnonymous();
  $variables['is_authenticated'] = $current_user->isAuthenticated();
}

