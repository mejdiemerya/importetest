function getCreditFilterLabel($tid)
{
  $parents = loadAllParentsModal($tid);
  $count = count($parents);
  $data = array('title' => '', 'description' => '');
  switch ($count) {
    case 1:
      // Only one item means we are looking at LEED Version.
      $data['title'] = strip_tags($parents[0]->name->value);
      break;

    case 2:
      $data['title'] = strip_tags($parents[0]->name->value);
      break;

    case 3:
      $data['title'] = strip_tags(sprintf('%s %s', $parents[1]->name->value, $parents[0]->name->value));
      if (isset($parents[0]->description) && !empty($parents[0]->description->value)) {
        $data['description'] = strip_tags($parents[0]->description->value);
      }
      break;

    case 4:
      $data['title'] = strip_tags(sprintf('%s %s', $parents[2]->name->value, $parents[0]->name->value));
      if (isset($parents[0]->description) && !empty($parents[0]->description->value)) {
        $data['description'] = strip_tags($parents[0]->description->value);
      }
      break;
  }
  return $data;
}

function loadAllParentsModal($tid)
{


  $parents = [];
  $term = Term::load($tid);


  if ($term) {
    $parents[] = $term;
    $n = 0;

    while (isset($parents[$n]) && $parent_id = $parents[$n]->parent->target_id) {

      if ($parent = Term::load($parent_id)) {
        $parents[] = $parent;
        $n++;
      } else {
        break;
      }
    }
  }


  return $parents;
}
function _lu_content_get_credit_faqs($term, $limit = 'all') {
  $limit = is_numeric($limit) && intval($limit) > 0 ? intval($limit) : NULL;

  $query = \Drupal::entityTypeManager()->getStorage('node')->getQuery()
    ->condition('type', 'credit_faq')
    ->condition('status', 1)
    ->sort('created', 'DESC')
    ->condition('field_credits.target_id', $term)->accessCheck(false);

  if ($limit) {
    $query->range(0, $limit);
  }

  $nids = $query->execute();

  $faqs = [];
  if (!empty($nids)) {
    $nodes = \Drupal::entityTypeManager()->getStorage('node')->loadMultiple($nids);
    foreach ($nodes as $node) {
      $faqs[] = [
        'nid' => $node->id(),
        'title' => $node->label(),
      ];
    }
  }

 return $faqs;
}

function getTipsheetName($nid)
{
  $query = \Drupal::entityTypeManager()->getStorage('node')->getQuery()
    ->condition('type', 'tipsheet')
    ->condition('nid', $nid)->accessCheck() // Replace 'field_credit' with the actual field linking to the credit.
    ->range(0, 1);

  $nids = $query->execute();
  if (!empty($nids)) {
    $node = \Drupal\node\Entity\Node::load(reset($nids));
    return $node->get('title')->value;
  }
  return '';
}

function getTermIdByName($term_name, $vocabulary)
{
  // Load the term storage handler.
  $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');

  // Create an entity query for terms.
  $query = $term_storage->getQuery()
    ->condition('vid', $vocabulary)
    ->condition('name', $term_name)->accessCheck(false);

  // Execute the query and fetch the TID.
  $tids = $query->execute();

  // Return the first TID found, or NULL if none found.
  return !empty($tids) ? reset($tids) : null;
}

function custom_forums_pathauto_alias_alter(&$alias, &$context)
{
  //for individual credit pages make the path /credit/[rating-system]/[credit]
  if ($context['bundle'] == 'credit' && isset($context['data']['term'])) {

    $credit_term = $context['data']['term']->id();

    $parents = loadAllParentsModal($credit_term);


    $new_alias = '/credit';

    //put parents in reverse order
    $parents = array_reverse($parents);
    $i = 0;
    foreach ($parents as $parent) {

      if (count($parents) == 4) {
        if ($i != 0 && $i != 2) {

          $new_alias .= '/' . $parent->name->value;

        }
      }
      $i++;
    }
    $alias = $new_alias;
  }
}

/**
 * Implementation of hook_preprocess_taxonomy_term()
 */
function custom_forums_preprocess_taxonomy_term(&$variables)
{
  $term = $variables['term'];
  //credit terms
  if ($term->bundle() === 'credit') {
    if (strpos($variables['content']['credit_bev']['#markup'], 'no LEEDuser summary') !== FALSE) {
      $variables['has_credit_bev'] = FALSE;
    } else {
      $variables['has_credit_bev'] = TRUE;
    }

    if (strpos($variables['content']['credit_faq']['#markup'], 'No results found') !== FALSE) {
      $variables['credit_faq'] = FALSE;
    } else {
      $variables['credit_faq'] = TRUE;
    }
    if (strpos($variables['content']['cost_guidance']['#markup'], 'No results found') !== FALSE) {
      $variables['cost_guidance_tab'] = FALSE;
    } else {
      $variables['cost_guidance_tab'] = TRUE;
    }
    $variables['show_doc_tab'] = TRUE;

    if (strpos($variables['content']['credit_documentation_section']['#markup'], 'No results found') !== FALSE && strpos($variables['content']['credit_resources']['#markup'], 'No results found') !== FALSE) {
      $variables['show_doc_tab'] = FALSE;
    }
    if (strpos($variables['content']['credit_documentation_section']['#markup'], 'No results found') !== FALSE) {
      $variables['content']['credit_documentation_section']['#markup'] = '';
    }

    if (strpos($variables['content']['credit_resources']['#markup'], 'No results found') !== FALSE) {
      $variables['content']['credit_resources']['#markup'] = '';
    }

    if (strpos($variables['content']['credit_addenda']['#markup'], 'This credit has no LEEDuser summary') !== FALSE) {
      $variables['addenda_tab'] = FALSE;
    } else {
      $variables['addenda_tab'] = TRUE;
    }
// Prepare the variables for the template.
    $theme_variables = [
      'documentation' => isset($variables['content']['credit_documentation_section']['#markup'])
        ? $variables['content']['credit_documentation_section']['#markup']
        : '',
      'resources' => isset($variables['content']['credit_resources']['#markup'])
        ? $variables['content']['credit_resources']['#markup']
        : '',
    ];
// Render the docs_tab template (assuming 'doc_toolkit_tab' is a defined theme hook or Twig template).
    $docs_tab = [
      '#theme' => 'doc_toolkit_tab',
      '#documentation' => ['#markup' => $theme_variables['documentation']],
      '#resources' => ['#markup' => $theme_variables['resources']],
    ];
    $variables['docs_tab'] = \Drupal::service('renderer')->render($docs_tab);
    //credit points
    $variables['credit_points'] = FALSE;

    if (substr($term->name->value, 0, 3) == 'MPR'
      || substr(preg_replace("/\d/", '', $term->name->value), -1) == 'p'
      || (isset($term->field_credit_meta_points) && !empty($term->field_credit_meta_points->value))) {

      // Exploding the value of field_credit_meta_points into an array
      $points = !empty($term->field_credit_meta_points->value) ? explode('-', $term->field_credit_meta_points->value) : [];

      if (substr($term->name->value, 0, 3) == 'MPR' || substr(preg_replace("/\d/", '', $term->name->value), -1) == 'p') {
        $variables['credit_points'] = 'Required';
      } elseif (count($points) == 1 && $points[0] == 1) {
        $variables['credit_points'] = $points[0] . ' point';
      } elseif (!empty($points)) {
        $variables['credit_points'] = $term->field_credit_meta_points->value . ' points';
      }
    }

    $aliasManager = \Drupal::service('path_alias.manager');
    $currentPath = \Drupal::service('path.current');

// Get the current path alias.
    $alias = $aliasManager->getAliasByPath($currentPath->getPath());

// Initialize variables.
    $variables['v41_credit_url'] = FALSE;
    $variables['v4_credit_url'] = FALSE;
    // Check and set updated URLs based on alias conditions.
    // Check for v4 or v4.1 and set updated URLs accordingly.
    if (strpos($alias, 'v4/') !== FALSE) {
      // If the alias is 'v4/', update to 'v4.1/'.
      $variables['v41_credit_url'] = _get_updated_url($alias, 'v4.1');
    }

    if (strpos($alias, 'v4.1/') !== FALSE) {
      // If the alias is 'v4.1/', update to 'v4/'.
      $variables['v4_credit_url'] = _get_updated_url($alias, 'v4');
    }
    $variables['can_access_leeduser_content'] = \Drupal::currentUser()->hasPermission('access leeduser premium content');
    $currentUser = \Drupal::currentUser();
    if ($currentUser->isAnonymous() || !\Drupal::currentUser()->hasPermission('access leeduser premium content')) {

      $membership_content_block = [
        '#theme' => 'membership_content_block',
      ];

      $variables['membership_content_block'] = \Drupal::service('renderer')->render($membership_content_block);
    }
    //credit language
    $variables['show_credit_language_tab'] = TRUE;
  }
}

function _get_checklist_by_taxonomy_tid($tid)
{
  $query = \Drupal::entityQuery('node')
    ->condition('type', 'credit_checklist') // Filter by content type 'checklist'
    ->condition('field_credits', $tid, 'CONTAINS') // Match the taxonomy term ID in the multiple field 'field_credits'
    ->accessCheck(TRUE); // Ensure proper access control

  $nids = $query->execute(); // Get an array of matching node IDs
  if (!empty($nids)) {
    // Load the nodes if any results are found
    $nodes = Node::loadMultiple($nids);

    return $nodes;
  }

  return []; // Return an empty array if no results
}

function _get_updated_url($alias, $replacement)
{
  // Check if the alias contains 'v4/' or 'v4.1/'.
  if (strpos($alias, 'v4/') !== FALSE || strpos($alias, 'v4.1/') !== FALSE) {
    // Replace 'v4/' or 'v4.1/' with the replacement value.
    if (strpos($alias, 'v4/') !== FALSE) {
      $updated_alias = str_replace('v4/', "$replacement/", $alias);
    } else {
      $updated_alias = str_replace('v4.1/', "$replacement/", $alias);
    }

    // Check if the updated alias is associated with a taxonomy term.
    if (is_taxonomy_term_from_alias($updated_alias)) {
      // Return the updated URL.
      return Url::fromUserInput('/' . ltrim($updated_alias, '/'))->toString();
    }
  }

  // Return FALSE if no match was found or no taxonomy term is associated with the alias.
  return FALSE;
}

function is_taxonomy_term_from_alias($alias)
{
  // Remove the '/credit' prefix and split alias into segments.
  $segments = explode('/', trim($alias, '/'));

  // Proceed if the alias has enough segments.
  if (count($segments) >= 3) {
    $rating_system = $segments[1];  // 'Mid-Rise-v4'
    $credit_term_name = $segments[2]; // 'MPR1'

    // Query for the taxonomy term by name.
    $parent_term_query = \Drupal::entityQuery('taxonomy_term')
      ->condition('name', $credit_term_name)
      ->accessCheck(FALSE)
      ->execute();

    foreach ($parent_term_query as $parent_term) {
      // Load all parent terms.
      $parents = array_reverse(loadAllParentsModal($parent_term));

      // Check if we have the expected number of parents.
      if (count($parents) == 4) {
        // Check the specific conditions for parent terms.
        foreach ($parents as $i => $parent) {
          if ($i != 0 && $i != 2 && $i != 3 && $parent->name->value == $rating_system) {
            return TRUE;
          }
        }
      }
    }
  }

  // Return false if no match is found.
  return FALSE;
}

