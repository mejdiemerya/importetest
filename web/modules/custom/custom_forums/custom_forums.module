/**
 * Helper function to get credit label from credit term.
 */
function _lu_get_credit_label_from_credit(Term $credit_term) {

  $query = \Drupal::entityQuery('taxonomy_term')
    ->condition('field_credits.target_id', $credit_term->id())->accessCheck(FALSE)
    ->condition('vid', 'credit_labels')
    ->range(0, 1); // Get only one result.

  $tids = $query->execute();

  // Load and return the first matching term if found.
  return $tids ? Term::load(reset($tids)) : NULL;
}

/**
 * Implements hook_views_post_execute().
 */
function custom_forums_views_post_execute(ViewExecutable $view) {
  // Check the view and displays.
  if ($view->id() === 'credit_page_tab_content' && in_array($view->current_display, ['credit_documentation_section', 'credit_documentation_section_mobile'], TRUE)) {
    foreach ($view->result as $row) {
      // Ensure the entity exists and is a node.
      $entity = $row->_entity ?? NULL;
      if ($entity instanceof NodeInterface && $entity->bundle() === 'tipsheet') {

        // Set the body to the summary if available.
        if ($entity->hasField('body') && !$entity->get('body')->isEmpty()) {
          $summary = $entity->body->summary;
          $row->_entity->set('body', $summary);
        }

        // Render custom tipsheet output.

//        $row->field_field_documents[0]['rendered'] = \Drupal::service('renderer')->render([
//          '#theme' => 'doc_toolkit_tipsheet',
//          '#tipsheet' => $entity,
//        ]);

      }
    }
  }
}
