/**
 * Implémente hook_ENTITY_TYPE_update() pour les nodes.
 */

/**
 * Implémente hook_node_update().
 */
function custom_forums_node_update(Node $node)
{
  // Vérifier si c'est un node de type 'team_account'.
  if ($node->bundle() === 'team_account') {
    // Récupérer le champ 'invite_people'.
    $emails = explode("\n", trim($node->get('field_invit_people')->value));

    // Vérifier s'il y a des emails.
    if (!empty($emails)) {
      // Récupérer l'ID du groupe (le node actuel est le groupe).
      $group_id = $node->id();
      $owner_mail = $node->getOwner()->getEmail();
      $owner_name = $node->getOwner()->getDisplayName();

      // Vérifier le nombre actuel de membres du groupe.
      $connection = \Drupal\Core\Database\Database::getConnection();
      $query = $connection->select('og_membership', 'ogm')
        ->condition('entity_id', $group_id)
        ->condition('entity_type', 'node')
        ->condition('state', \Drupal\og\Entity\OgMembership::STATE_ACTIVE)
        ->countQuery();
      $current_members_count = $query->execute()->fetchField();


      // Limite du groupe à 10 membres.
      $max_members = $node->field_nbr_max->getValue()[0]['value'];
      if ($current_members_count >= $max_members) {
        \Drupal::messenger()->addError("The team account has reached the maximum of 10 members.");
        return;
      }

      foreach ($emails as $email) {
        $email = trim($email);
        if (filter_var($email, FILTER_VALIDATE_EMAIL)) {
          // Vérifier si l'utilisateur existe déjà.
          $existing_user = user_load_by_mail($email);

          if (!$existing_user) {
            // Créer un nouvel utilisateur.
            $user = User::create([
              'name' => $email,
              'mail' => $email,
              'status' => 1, // Activer le compte.
              'roles' => ['lu_premium'], // Assigner le rôle.
            ]);
            $user->save();
          } else {
            $user = $existing_user;
          }
          $query = $connection->select('og_membership', 'ogm')
            ->condition('entity_id', $group_id)
            ->condition('entity_type', 'node')
            ->condition('state', \Drupal\og\Entity\OgMembership::STATE_ACTIVE)
            ->countQuery();
          $current_members_count = $query->execute()->fetchField();
          // Vérifier à nouveau la limite après chaque ajout.
          if ($current_members_count >= $max_members) {
            \Drupal::messenger()->addError("Cannot add more users. The team account has reached the maximum of 10 members.");
            break;
          }

          // Assigner l'utilisateur au groupe en tant que membre.
          if (!Og::isMember($node, $user)) {
            Og::createMembership($node, $user)
//              ->setRoles(['lu_premium_og']) // Ajouter le rôle de groupe.
              ->save();
          }

          // Envoyer l'email de bienvenue.
          custom_forums_send_welcome_email($user, $owner_name, $owner_mail);
        }
      }
    }

    // Réinitialiser le champ `field_invite_people` après chaque mise à jour.
    $node->set('field_invit_people', '');
//    $node->save();
  }
}

/**
 * Fonction pour envoyer un e-mail de bienvenue.
 */
function custom_forums_send_welcome_email(\Drupal\user\Entity\User $user, $owner_name, $owner_mail)
{
  $mailManager = \Drupal::service('plugin.manager.mail');
  $module = 'my_module';
  $key = 'welcome_email';
  $to = $user->getEmail();
  $langcode = $user->getPreferredLangcode();
  $params['subject'] = 'Welcome to LEEDuser Team Membership';
  $params['message'] = "
Hello " . $user->getDisplayName() . ",

You have been added to container’s team membership at LEEDuser.com.

This gives you full access to LEEDuser’s premium content. We invite you to log into LEEDuser and start browsing our wide range of LEED credit information and forums.

https://www.leeduser.buildinggreen.com/user

If you have questions about this invitation, contact $owner_name ($owner_mail).

For all other questions, contact BuildingGreen, Inc. customer service at customersupport@buildinggreen.com.

LEEDuser is a product of BuildingGreen, Inc.
";

  $mailManager->mail($module, $key, $to, $langcode, $params);
}


/**
 * Implements hook_views_query_alter().
 */
function custom_forums_views_query_alter(ViewExecutable $view, QueryPluginBase $query)
{
  if ($view->id() == 'credit_page_tab_content') {

    if (strpos($view->current_display, 'credit_bev') === 0) {

      // Clear all existing conditions.
      $query->where = [];

      // Set group operator to OR.
      $query->setGroupOperator('OR');

      // Load the credit term and credit label.
      $credit_term = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($view->args[0]);
      $credit_label = _lu_get_credit_label_from_credit($credit_term);

      // Ensure the join uses the correct fields.
      $join = new \Drupal\views\Plugin\views\join\Standard([
        'table' => 'node__field_credit_labels',
        'field' => 'entity_id',
        'left_table' => 'node_field_data', // Correct table for node data in Drupal 10.
        'left_field' => 'nid',  // Ensure the left_field is set correctly.
      ], 'LEFT', 'node_field_data', 'nid');

      // Add the relationship to the query.
      $query->addRelationship('node__field_credit_labels', $join, 'node_field_data');

      // Create a condition group for the AND conditions.
      $existing_conditions = new Condition('AND');

      // Add the published status check if the user does not have admin permission.
      if (!\Drupal::currentUser()->hasPermission('administer site configuration')) {
        $existing_conditions->condition('node_field_data.status', 1, '=');
      }

      // Add conditions based on field_credits and field_project_phase.
      $existing_conditions->condition('node__field_credits.field_credits_target_id', $view->args[0], '=');

      $existing_conditions->condition('node_field_data.type', ['credit_bev', 'credit_bev_image'], 'IN');

      // Add the AND conditions to the query.
      $query->addWhere(1, $existing_conditions);
      if ($credit_label) {
      // Create a condition group for the OR conditions.
      $or_conditions = new Condition('AND');

      // Add conditions for credit labels and project phase.
      $or_conditions->condition('node__field_credit_labels.field_credit_labels_target_id', $credit_label->id(), '=');
      $or_conditions->condition('node_field_data.type', ['credit_bev', 'credit_bev_image'], 'IN');

      // Include unpublished nodes for admin users.
      if (\Drupal::currentUser()->hasPermission('administer site configuration')) {
        $or_conditions->condition('node_field_data.status', 1, '=');
      }

      // Add the OR conditions to the query.
      $query->addWhere(2, $or_conditions);
    }
    }
    if (strpos($view->current_display, 'credit_faq') === 0) {

      // Clear all existing conditions.
