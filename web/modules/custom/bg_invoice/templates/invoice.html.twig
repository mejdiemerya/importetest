<html>
<head>
    <style>
        body {
            font-family: Helvetica, Arial, sans-serif;
            line-height: 1.6;
        }
        .header {
            text-align: center;
            margin-bottom: 20px;
        }
        .details, .footer {
            margin: 20px 0;
        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        table, th, td {
            border: 1px solid black;
        }
        th, td {
            padding: 8px;
            text-align: left;
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Invoice</h1>
        <p>{{ customer_name }}</p>
        <p>{{ customer_address }}</p>
    </div>
    <div class="details">
        <p>Invoice No.: {{ invoice_no }}</p>
        <p>Order No.: {{ order_no }}</p>
        <p>Date: {{ date }}</p>
    </div>
    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Unit Price</th>
                <th>Quantity</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>{{ title }}</td>
                <td>{{ unit_price }}</td>
                <td>{{ quantity }}</td>
                <td>{{ total }}</td>
            </tr>
        </tbody>
    </table>
    <div class="footer">
        <p>Balance Due: {{ balance_due }}</p>
    </div>
</body>
</html>
