<?php

/**
 * @file
 * Primary module hooks for bg_user_api module.
 * @param Drupal\user\Entity\User $account
 */
function bg_user_api_user_presave($account)
{
  if (!$account->isNew()) {

    foreach ($account->getRoles() as $role) {
      if (!empty(convertRoleToD7($role)))
        $post_fields['roles'] [convertRoleToD7($role)] = $role;
    }
    if (!empty($post_fields['roles'])) {
      $post_fields['uid'] = $account->id();
      sendHttpRequest($post_fields, 'put');
    }
  }
}

function bg_user_api_form_alter(&$form, &$form_state, $form_id)
{
  if ($form_id == "user_register_form") {
    $form['actions']['submit']['#submit'][] = ('bg_user_api_user_register_form_submit');
  }
  if ($form_id == "commerce_checkout_flow_multistep_default") {
    $form['#submit'][] = ('bg_user_api_form_commerce_checkout_form_registration_submit');
  }
}

/**
 * Implements bg_user_api_user_register_form_submit()
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 */
function bg_user_api_user_register_form_submit(&$form, &$form_state)
{
  $post_fields['uid'] = $form_state->getValue('uid');
  $post_fields['name'] = $form_state->getValue('name');
  $post_fields['mail'] = $form_state->getValue('mail');
  $post_fields['pass'] = $form_state->getValue('pass');
  $post_fields['roles'] = array(18); // 18 = pre-authorized
  $result = sendHttpRequest($post_fields);
}

/**
 * Implements bg_user_api_form_commerce_checkout_form_registration_submit()
 * @param \Drupal\Core\Form\FormStateInterface $form_state
 */
function bg_user_api_form_commerce_checkout_form_registration_submit(&$form, &$form_state)
{

  if (!empty($form_state->getValue('login')) && !empty($form_state->getValue('login')['register'])) {

    $values = $form_state->getValue('login')['register'];
    $post_fields['name'] = $values['name'];
    $post_fields['mail'] = $values['mail'];
    $post_fields['pass'] = $values['password'];

    $post_fields['uid'] = $form_state->getStorage()["logged_in_uid"];
    $post_fields['roles'] = array(18); // 18 = pre-authorized
    $result = sendHttpRequest($post_fields);
  }
}


function sendHttpRequest($post_fields = null, $method = 'post')
{
  $config = \Drupal::config('bg_user_api.settings');
  $api_url = rtrim($config->get('api_url'), '/');
  $api_user = $config->get('api_user');
  $api_password = $config->get('api_password');
  if (!$api_url || !$api_user || !$api_password) {
    \Drupal::logger('bg_user_api')->error('API configuration is missing.');
    return NULL;
  }
  if ($method == 'put') {
    $url = $api_url . '/' . $post_fields['uid'];

    $uid = $post_fields['uid'];
    unset($post_fields['uid']);
    $response = \Drupal::httpClient()
      ->put($url, [
        'auth' => [$api_user, $api_password],
        'body' => json_encode($post_fields),
        'http_errors' => FALSE,
        'headers' => [
          'Content-Type' => 'application/json',
        ],
      ])->getBody()->getContents();
    \Drupal::logger('bg_user_api')->debug(
      'Update user id ' . $uid . '<br> Api url :' . $url . ' </br>Result update user to d7: <pre>@placeholder_name</pre>',
      array('@placeholder_name' => print_r($response, TRUE))
    );
  } else {
    $post_fields['status'] = 1;
    $url = $api_url . '/register';
    $response = \Drupal::httpClient()
      ->post($url, [
        'auth' => [$api_user, $api_password],
        'body' => json_encode($post_fields),
        'http_errors' => FALSE,
        'headers' => [
          'Content-Type' => 'application/json',
        ],
      ])->getBody()->getContents();
    \Drupal::logger('bg_user_api')->debug(

      '<br>Adding user email ' . $post_fields['mail'] . '<br> Api url :' . $url . ' </br>Result add user to d7: <pre>@placeholder_name</pre>',
      array('@placeholder_name' => print_r($response, TRUE))
    );
  }


  return $response;
}

function convertRoleToD7($role)
{
  $tabD7 = [
    'bg_communities' => 16,
    'bg_premium' => 4,
    'bg_premium_og' => 5,
    'bg_trial' => 6,
    'bg_og_multiuser' => 7,
    'autologin' => 8,
    'bg_og_parent' => 9,
    'lu_premium' => 10,
    'lu_premium_og' => 11,
    'lu_trial' => 12,
    'lu_og_multiuser' => 13,
    'lu_og_parent' => 14,
    'lu_guest_expert' => 15,
    'editor' => 17,
    'bg_basic' => 19,
    'lu_basic' => 20,
    'pre-authorized' => 18,
  ];

  return isset($tabD7[$role]) ? $tabD7[$role] : 0;
}
