{#
/**
 * @file
 * Theme override to display a taxonomy term.
 *
 * Available variables:
 * - url: URL of the current term.
 * - name: (optional) Name of the current term.
 * - content: Items for the content of the term (fields and description).
 *   Use 'content' to print them all, or print a subset such as
 *   'content.description'. Use the following code to exclude the
 *   printing of a given child element:
 *   @code
 *   {{ content|without('description') }}
 *   @endcode
 * - attributes: HTML attributes for the wrapper.
 * - page: Flag for the full page state.
 * - term: The taxonomy term entity, including:
 *   - id: The ID of the taxonomy term.
 *   - bundle: Machine name of the current vocabulary.
 * - view_mode: View mode, e.g. 'full', 'teaser', etc.
 *
 * @see template_preprocess_taxonomy_term()
 */
#}
{% set classes = [
  'taxonomy-term page--credit mb-4',
  'vocabulary-' ~ term.bundle|clean_class,
] %}
{{ attach_library('buildinggreen/page-credit') }}
<div{{ attributes.setAttribute('id', 'taxonomy-term-' ~ term.id).addClass(classes) }}>
  {{ title_prefix }}
  {% if name and not page %}
    <h2><a href="{{ url }}">{{ name }}</a></h2>
  {% endif %}
  {{ title_suffix }}

  <div class="content">
    <h1 class="page-header">{{ content.title_forum }}: {% if content.description.0['#text'] %}<em>{{ content.description.0['#text']|striptags }}</em>{% endif%} {% if credit_points %}<span
        class="label">{{ credit_points }}</span>{% endif %}</h1>

    <div class="content">
      <div class="visible-md-block visible-lg-block visible-xl-block">
        <div class="row">
          <div class="col-sm-3 col-lg-2">
            <ul class="nav nav-pills nav-stacked credit-page-nav">
              {% if has_credit_bev %}
                <li role="presentation" class="active"><a data-toggle="pill" href="#bev">LEEDuser&rsquo;s viewpoint</a>
                </li>
              {% endif %}
              {% if show_credit_language_tab %}
                <li role="presentation" class="{% if not has_credit_bev %}active{% endif %}">
                  <a data-toggle="pill" href="#credit-language">Credit language</a>
                </li>
              {% endif %}
              {% if cost_guidance_tab %}
                <li role="presentation"><a data-toggle="pill" href="#cost">What does it cost?</a></li>
              {% endif %}
              {% if content.credit_checklists['#markup'] is not empty %}
                <li role="presentation"><a data-toggle="pill" href="#checklists">Checklists</a></li>
              {% endif %}

              {% if show_doc_tab %}
                <li role="presentation"><a data-toggle="pill" href="#docs">Documentation toolkit</a></li>
              {% endif %}

              {% if credit_faq %}
                <li role="presentation"><a data-toggle="pill" href="#faq">FAQ</a></li>
              {% endif %}

              {% if addenda_tab %}
                <li role="presentation"><a data-toggle="pill" href="#addenda">Addenda</a></li>
              {% endif %}

            </ul>
            <a href="/forums/?f[0]=credit:{{ term.tid.value }}" class="btn btn-midtone btn-wrap text-start mt-4"><strong>See
                all forum discussions about this credit&nbsp;&raquo;</strong></a>
            {% if content.flag_subscription_credit %}
              <div class="mt-4">{{ content.flag_subscription_credit }}</div>{% endif %}

            {% if 'v4/' in url %}
              <div class="visible-md-block mt-4">
                <p class="mt-0 small mb-0 text-muted">SPECIAL REPORT</p>
                <a href="/continuing-education/cost-leed-v4">
                  <img class="img-fluid"
                       src="/themes/custom/buildinggreen/front_app/dist/assets/images/COLv4_cover_0.png"
                       alt="Cost of LEED v4"/>
                </a>
              </div>
            {% endif %}

          </div>
          <div class="col-sm-9 col-md-8 col-lg-7 magnify">
            <div class="tab-content">

              <div class="tab-pane" id="overview">
                <p class="supertitle mb-0">LEEDuser overview</p>
                {% if membership_promo_block %}
                  {{ membership_promo_block }}
                {% endif %}
              </div><!-- end tab-pane -->

              <div class="tab-pane active" id="bev">
                <p class="supertitle mb-0">LEEDuser overview</p>
                {% if not membership_promo_block %}
                  {{ content.credit_bev }}
                  <a href="/forums/?f[0]=credit:{{ term.tid.value }}"
                     class="btn btn-midtone btn-wrap btn-left btn-xl mt-5"><strong>See all forum discussions about this
                      credit&nbsp;&raquo;</strong></a>
                {% endif %}
              </div><!-- end tab-pane -->

              <div class="tab-pane" id="credit-language">
                <p class="supertitle">Credit language</p>
                <div class="well well-sm">
                  <div class="media">
                    <div class="media-left media-middle">
                      <img class="media-object" src="/themes/custom/buildinggreen/front_app/dist/assets/images/usgbc_170.png" width="85"
                           alt="USGBC logo">
                    </div>
                    <div class="media-body">
                      <p class="xsmall mt05">&copy; Copyright U.S. Green Building Council, Inc. All rights reserved.</p>
                    </div>
                  </div>
                </div>
                {% if content.field_intent['#items'] is not empty %}
                  <h4>Intent</h4>
                  {{ content.field_intent.0['#text']|raw }}
                {% endif %}
                {% if content.field_credit_requirement_text['#items'] is not empty %}
                  <h4>Requirements</h4>
                  {{ content.field_credit_requirement_text.0['#text']|raw }}
                {% endif %}
                <a href="/forums/?f[0]=credit:{{ term.tid.value }}"
                   class="btn btn-midtone btn-wrap btn-left btn-xl mt-5"><strong>See all forum discussions about this credit&nbsp;&raquo;</strong></a>

              </div><!-- end tab-pane -->

              <div class="tab-pane" id="faq">
                <p class="supertitle mb0">Frequently asked questions</p>
                {{ content.credit_faq|raw }}
                <a href="/forums/?f[0]=credit:{{ term.tid.value }}"
                   class="btn btn-midtone btn-wrap btn-left btn-xl mt-5"><strong>See all forum discussions about this credit&nbsp;&raquo;</strong></a>

              </div><!-- end tab-pane -->
              <div class="tab-pane" id="cost">
                {{ content.cost_guidance|raw }}
                <a href="/forums/?f[0]=credit:{{ term.tid.value }}"
                   class="btn btn-midtone btn-wrap btn-left btn-xl mt-5"><strong>See all forum discussions about this credit&nbsp;&raquo;</strong></a>

              </div>
              <div class="tab-pane" id="checklists">
                <p class="supertitle">Checklists</p>
                <div class="checklist">
                  {% if     membership_promo_block %}
                    <paywall></paywall>
                  {% else %}
                    <table class="legend nullify">
                      <tr>
                        <td><strong>LEGEND:</strong></td>
                        <td><span class="glyphicon glyphicon-ok" style="color: #4f85da;"></span> Action steps</td>
                        <td><span class="glyphicon glyphicon-thumbs-up" style="color: #577974;"></span> Best practices
                        </td>
                        <td><span class="glyphicon glyphicon-piggy-bank" style="color: #eaa0ad;"></span> Cost tip</td>
                        <td><span class="glyphicon glyphicon-flash" style="color: #f66;"></span> Hot tip</td>
                      </tr>
                    </table>
                    {{ content.credit_checklists|raw }}
                    <a href="/forums/?f[0]=credit:{{ term.tid.value }}"
                       class="btn btn-midtone btn-wrap btn-left btn-xl mt-5"><strong>See all forum discussions about this
                        credit&nbsp;&raquo;</strong></a>

                  {% endif %}
                </div><!-- end checklist -->
              </div><!-- end tab-pane -->

              <div class="tab-pane nullify" id="docs">
                <p class="supertitle">Documentation toolkit</p>
                {% if membership_promo_block %}
                  <paywall></paywall>
                {% else %}
                  {{ docs_tab }}
                  <a href="/forums/?f[0]=credit:{{ term.tid.value }}"
                     class="btn btn-midtone btn-wrap btn-left btn-xl mt-5"><strong>See all forum discussions about this credit&nbsp;&raquo;</strong></a>

                {% endif %}
                <hr>
              </div><!-- end tab-pane -->
              <div class="tab-pane" id="addenda">
                <p class="supertitle mb0">Addenda</p>
                {{ content.credit_addenda }}
                <a href="/forums/?f[0]=credit:{{ term.tid.value }}"
                   class="btn btn-midtone btn-wrap btn-left btn-xl mt-5"><strong>See all forum discussions about this credit&nbsp;&raquo;</strong></a>

              </div>

            </div><!-- end tab-content -->


          </div><!-- end col -->
          <div class="col-lg-3 hidden-md">
            {{ content.field_guest_expert }}
          </div>
        </div>
      </div>
    </div><!-- end visible-sm etc. -->

  </div>


</div><!-- end .content -->



