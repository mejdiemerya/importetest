      <ul >
        <li ><strong >{{ 'Monthly premium membership'|t }}</strong> {{ '(auto-renews):'|t }} <a class="line ng-scope" >{{ 'Get it now for'|t }} <span  >$15.95</span>{{ '/month'|t }}</a>.</li>
        <li ><strong >{{ 'Annual premium membership'|t }}</strong> {{ '(auto-renews):'|t }} <a class="line ng-scope" >{{ 'Get it now for'|t }} <span  >$159</span>{{ '/year'|t }}</a>.</li>
        <li  ><strong >{{ 'Basic membership'|t }}</strong>: <a class="line" href="/signup?destination=forums" >{{ 'Sign upfor free'|t }}</a>.</li>
      </ul></div>
  </div>
</div>
