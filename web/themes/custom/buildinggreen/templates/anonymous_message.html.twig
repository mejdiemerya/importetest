<h2>{{ 'Sign in to use the forum'|t }}</h2>
<div class="row" >
  <div class="col-md-6"  >
    <div class="breathe" >
      <p ><em >{{ 'Forum access is included with all levels of LEEDuser membership (basic and premium).'|t }}</em></p>
      <a href="#" class="btn btn-primary mb10">{{ 'Log in now'|t }}</a>
      <span>OR</span><br>
      <a href="/signup?destination=forums" class="btn btn-success" >{{ 'Create a free basic membership'|t }}</a>
    </div>
  </div>
  <div class="col-md-6"  >
    <div class="breathe" >
