<div class="modal fade" id="post-question-modal" tabindex="-1" role="dialog" aria-labelledby="modalPostQuestionLabel"
     aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="btn-close" data-bs-dismiss="modal"
                aria-label="Close"></button>
      </div>
      {% if is_anonymous %}
        <h3 class="modal-title p-4" id="modalLoginLabel">Sign in to use the forum</h3>
      {% endif %}
      <div class="modal-body post-question">
        {% if is_anonymous %}
          <div class="row">
            <div class="col-md-6" id="modal-option1">
              <div class="breathe">
                <p><em>Forum access is included with all levels of LEEDuser membership (basic and premium).</em></p>
                <a href="#" class="btn btn-primary mb10" data-toggle="modal" data-target="#login-modal"
                   data-dismiss="modal">Log in now</a> <span
                  style="display: inline-block; line-height: 2; vertical-align: text-bottom; padding-left: 10px;">OR</span><br>
                <a
                  href="/signup?destination=<?php print urlencode(filter_xss(drupal_get_destination()['destination']));?>"
                  class="btn btn-success mt-2">Create a free basic membership</a>
              </div>
            </div><!-- end option 1 -->
            <div class="col-md-6" id="modal-option2">
              <div class="breathe">
{#                <hr class="visible-xs-block visible-sm-block">#}
                <p><em><strong>Not a member yet?</strong> LEEDuser Premium membership gives you access to all credit
                    tips, checklists, documentation samples, and more.</em></p>
                <ul>
                  <li style="line-height: 1.4;"><strong>Monthly premium membership</strong> (auto-renews): <a
                      class="line" href="" buy="77" data-toggle="modal" data-target="#signup-modal"
                      data-dismiss="modal">Get it now for
                      <price id="77"></price>
                      /month</a>.
                  </li>
                  <li style="line-height: 1.4;" class="mt05"><strong>Annual premium membership</strong> (auto-renews):
                    <a class="line" href="" buy="70" data-toggle="modal" data-target="#signup-modal"
                       data-dismiss="modal">Get it now for
                      <price id="70"></price>
                      /year</a>.
                  </li>
                  <li style="line-height: 1.4;" class="mt05"><strong>Basic membership</strong>: <a class="line"
                                                                                                   href="/signup?destination=<?php print urlencode(filter_xss(drupal_get_destination()['destination']));?>">Sign
                      up for free</a>.
                  </li>
              </div>
            </div><!-- end option 2 -->
          </div><!-- end row -->
        {% endif %}
        {% if is_authenticated %}

          <div class="row">
            <div class="col-md-6" id="modal-option1">
              <p class="supertitle">OPTION 1</p>
              <p class="large"><strong>Post to a credit forum:</strong></p>
              {{ drupal_form('Drupal\\custom_forums\\Form\\TopicForm') }}
            </div><!-- end option 1 -->
            <div class="col-md-6" id="modal-option2">
{#              <hr class="visible-xs-block visible-sm-block">#}
              <p class="supertitle">OPTION 2</p>
              <p class="large"><strong>Post to another forum:</strong></p>

              {{ drupal_view('general_forums') }}
            </div><!-- end option 2 -->
          </div><!-- end row -->
        {% endif %}
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-default" data-bs-dismiss="modal" aria-label="Close">Close</button>
      </div>
    </div>
  </div>
</div>
