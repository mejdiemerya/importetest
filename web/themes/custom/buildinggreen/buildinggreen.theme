<?php

use Drupal\Core\Database\Database;
use Drupal\Core\Datetime\DateFormatterInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\StringTranslation\TranslatableMarkup;
use Drupal\Core\Url;
use Drupal\node\Entity\Node;
use Drupal\user\Entity\User;

/**
 * @file
 * buildinggreen theme file.
 */
function buildinggreen_theme_suggestions_page_alter(array &$suggestions, array $variables)
{
  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    $content_type = $node->bundle();
    $suggestions[] = 'page__' . $content_type;
  }
  if ($term = \Drupal::routeMatch()->getParameter('taxonomy_term')) {
    $content_type = $term->bundle();
    $suggestions[] = 'page__taxonomy__' . $content_type;
  }
}
function buildinggreen_theme_suggestions_user_alter(array &$suggestions, array $variables) {
  /** @var \Drupal\user\Entity\User $user */
  $user = $variables['elements']['#user'];
  $view_mode = $variables['elements']['#view_mode'];

  // Suggestion based on view mode
  if (!empty($view_mode)) {
    $suggestions[] = 'user__' . $view_mode;
  }

}
function buildinggreen_preprocess_user(&$variables){
  $current_user = \Drupal::currentUser();
  $uid = $current_user->id();
  $variables['current_user_id'] = $uid;

  // Assuming you extract the user ID from the URL somehow
  $route_match = \Drupal::routeMatch();
  $user = $route_match->getParameter('user');

  // Ensure we have a valid user entity.
  if ($user instanceof \Drupal\user\Entity\User) {
    $variables['url_user_id'] = $user->id();
  }
}
function buildinggreen_preprocess_node(&$variables)
{
  $node = $variables['node'];


if ($node->getType() == 'forum') {
if ($variables['node']->hasField('uid') && !$variables['node']->get('uid')->isEmpty()) {
  $account = $variables['node']->get('uid')->entity;
  if ($account && $account->hasField('field_first_name') && $account->hasField('field_last_name')) {
    $variables['author_first_name'] = $account->get('field_first_name')->value;
    $variables['author_last_name'] = $account->get('field_last_name')->value;
  }
}
if ($variables['node']->hasField('field_project_location') && !$variables['node']->get('field_project_location')->isEmpty()) {
  $term = $variables['node']->get('field_project_location')->entity;

  $variables['project_location_tid'] = $term->id();
}


}
  //check content type
  if ($node->getType() == 'blog') {
    $currentUser = \Drupal::currentUser();

    if ($currentUser->isAnonymous() || !\Drupal::currentUser()->hasPermission('access leeduser premium content')) {

      $membership_promo_block = [
        '#theme' => 'membership_promo_block',
      ];

      $membership_promo_block = \Drupal::service('renderer')->render($membership_promo_block);
      $found = preg_match_all("/<\/p>/", $variables['content']['body'][0]['#text'], $matches, PREG_OFFSET_CAPTURE);
      $num_paragraphs = 5;
      if ($found !== FALSE && $found > $num_paragraphs) {
        $variables['content']['body'][0]['#text'] = substr_replace($variables['content']['body'][0]['#text'], '</p>' . $membership_promo_block, $matches[0][$num_paragraphs][1], strlen('</p>'));
      }
    }
    $variables['#attached']['library'][] = 'buildinggreen/blog';
  }
  // Obtenir le timestamp de création du contenu.
  $timestamp = $node->getCreatedTime();

  // Formater la date en "time ago".
  $date_formatter = \Drupal::service('date.formatter');
  $variables['time_ago'] = $date_formatter->formatTimeDiffSince($timestamp);
}

/**
 * Implémente hook_preprocess_HOOK().
 */
function buildinggreen_preprocess_page(&$variables)
{
  $current_user = \Drupal::currentUser();
  $uid = $current_user->id();
  $variables['current_user_id'] = $uid;

  // Assuming you extract the user ID from the URL somehow
  $route_match = \Drupal::routeMatch();
  $user = $route_match->getParameter('user');

  // Ensure we have a valid user entity.
  if ($user instanceof User) {
    $variables['url_user_id'] = $user->id();
  }
  // Vérifie si l'utilisateur est connecté.
  if (\Drupal::currentUser()->isAuthenticated()) {





    // Récupère l'ID de l'utilisateur connecté.
    $current_user_id = \Drupal::currentUser()->id();

    // Charge l'utilisateur connecté.
    $account = \Drupal\user\Entity\User::load($current_user_id);
    if (array_intersect(['bg_og_multiuser', 'lu_og_multiuser'], $account->getRoles()))
    {
      $variables['group_level']= 'enterprise';
    }else{
      $variables['group_level'] = 'individual';
    }

//trial status - LU
    $variables['trial_status_lu'] = 'not_taken';
    if ((isset($account->get('field_trial_taken_lu')->value) && ($account->get('field_trial_taken_lu')->value == 1)) )
    {
      //expired premium user who also took trial previously
      $variables['trial_status_lu'] = 'premium_expired';

    }

    //membership_level - LU
    if ( $account->hasPermission('access leeduser premium content'))
    {
      $variables['is_lu_premium']  = 'premium';
    }else{
      $variables['is_lu_basic'] = 'basic';
    }
    // Load nodes of type 'campus_wide_account' where the current user is the owner.
    $query = \Drupal::entityQuery('node')
      ->condition('type', 'campus_wide_account')
      ->condition('uid', $current_user_id)
      ->accessCheck(TRUE)
      ->range(0, 1);

    $nids = $query->execute();
    if($nids){
      $group_nid = reset($nids);
      $node = Node::load(reset($nids));
      $group_name = $node->getTitle();
      $variables['group_type']='campus_wide_account';
      $variables['group_name'] = $group_name;
    }
    $query = \Drupal::entityQuery('node')
      ->condition('type', 'firm_wide_account')
      ->condition('uid', $current_user_id)
      ->accessCheck(TRUE)
      ->range(0, 1);

    $nids = $query->execute();
    if($nids){
      $group_nid = reset($nids);
      $node = Node::load(reset($nids));
      $group_name = $node->getTitle();
      $variables['group_type']='firm_wide_account';
      $variables['group_name'] = $group_name;
    }
// Load nodes of type 'team_account' where the current user is the owner.
    $query = \Drupal::entityQuery('node')
      ->condition('type', 'team_account')
      ->condition('uid', $current_user_id)
      ->accessCheck(TRUE)
      ->range(0, 1);

    $nids = $query->execute();
    if (!empty($nids)) {
      $group_nid = reset($nids);
      $node = Node::load(reset($nids));
      $group_name = $node->getTitle();
      $groupe_parent_id=$node->getOwnerId();
      $variables['group_name'] = $group_name;
      $variables['group_nid'] = $group_nid;
      $variables['groupe_parent_id']=$groupe_parent_id;
      $total_members = _get_group_total_members($variables['group_nid']);

      // Pass total members to the template.
      $variables['total_members'] = $total_members;
    }
$is_premium_user = $account->hasRole('lu_premium_og');
$variables['is_premium_user'] = $is_premium_user;
    $is_og_parent = $account->hasRole('lu_og_parent');
    $variables['is_og_parent'] = $is_og_parent;
    // Récupère les champs personnalisés (prénom et nom).
    $first_name = $account->get('field_first_name')->value ?? '';
    $last_name = $account->get('field_last_name')->value ?? '';
    $organisation=$account->get('field_organization')->value ?? '';
    $variables['organisation'] = $organisation;

    // Passe les variables au fichier Twig.
    $variables['user_id'] = $current_user_id;
    $variables['first_name'] = $first_name;
    $variables['last_name'] = $last_name;
    $variables['titlesubscription'] = $last_name;

      $subscriptions = \Drupal::entityTypeManager()
      ->getStorage('commerce_subscription')
      ->loadByProperties([
        'state' => 'active',
        'uid' => $current_user_id,
      ]);

    $subscription = reset($subscriptions);
    if (!empty($subscription)) {
      $renewal_date = $subscription->getNextRenewalDate();
      $renewal_date = $renewal_date->getTimestamp();
      $dateTime = new DateTime();
      $dateTime->setTimestamp($renewal_date);
      $dateTime->setTimezone(new DateTimeZone('America/New_York'));

// Formater la date
      $date = $dateTime->format('n/j/Y');
// Obtenir la première commande
      $orders = $subscription->getOrders(); // Stocker le résultat dans une variable

      $order = reset($orders);
// Formater le prix total
      $formatted_number = number_format($order->total_price->getvalue()[0]['number'], 2);

// Récupérer le titre de l'abonnement
      $subscription_title = $subscription->title->getvalue()[0]['value'];

// Construire les variables
      $variables['titlesubscription'] = $subscription_title;
      $variables['billed'] = $subscription->getBillingSchedule()->label();
      $variables['renewed'] = $date;
      $variables['totl'] = $formatted_number;
      $form = \Drupal::service('entity.form_builder')->getForm($subscription, 'cancel');
      $current_user = \Drupal::currentUser();
      $uid = $current_user->id();


        // Passer le formulaire au template Twig.
      $variables['subscription_edit_form'] = $form;
      $variables['current_user_id'] = $uid;

      // Assuming you extract the user ID from the URL somehow
      $route_match = \Drupal::routeMatch();
      $user = $route_match->getParameter('user');

      // Ensure we have a valid user entity.
      if ($user instanceof \Drupal\user\Entity\User) {
        $variables['url_user_id'] = $user->id();
      }
    }


  } else {
    // Si l'utilisateur est anonyme.
    $variables['user_id'] = NULL;
    $variables['first_name'] = NULL;
    $variables['last_name'] = NULL;
  }

}/**
 * Function to get the total number of group members.
 */
function _get_group_total_members($group_nid) {
  // Load the group node to get the owner's ID.
  $group = Node::load($group_nid);
  if (!$group) {
    return 0;
  }

  $owner_id = $group->getOwnerId();

  // Database query to get the count of members excluding the owner.
  $connection = Database::getConnection();
  $query = $connection->select('og_membership', 'ogm')
    ->condition('entity_id', $group_nid)
    ->condition('entity_type', 'node')
    ->condition('state', 'active')
    ->condition('uid', $owner_id, '<>')
    ->countQuery();

  return (int) $query->execute()->fetchField();
}

/**
 * Implements hook_preprocess_menu().
 */
function buildinggreen_preprocess_menu(&$variables) {
  if ($variables['menu_name'] === 'menu-user') {
    $current_user = \Drupal::currentUser();
    $destination = \Drupal::destination()->getAsArray();
    $destination_encoded = urlencode($destination['destination'] ?? '');
    $roles = $current_user->getRoles();
    if (!$current_user->isAuthenticated() || !array_intersect(['bg_og_multiuser', 'lu_og_multiuser'], $current_user->getRoles())) {
      foreach ($variables['items'] as $key => $item) {
        if (trim($item['title']) === 'Create a profile') {
          unset($variables['items'][$key]);
        }
      }
    }

    if (array_intersect(['bg_og_multiuser', 'lu_og_multiuser'], $roles)) {
        $variables['items'] = [];

        // Create a profile (via logout + redirect)
        $variables['items'][] = [
          'title' => 'Create a profile',
          'url' => Url::fromUri('internal:/user/logout', [
            'query' => ['destination' => "create-profile?destination=$destination_encoded"],
          ]),
          'attributes' => [],
        ];

        $variables['items'][] = [
          'title' => 'Log in',
          'url' => Url::fromUri('internal:/user/logout', [
            'query' => ['destination' => "user?destination=$destination_encoded"],
          ]),
          'attributes' => [
            'class' => ['login', 'hidden-xs'],
          ],
        ];
      }
    }

}
function  buildinggreen_form_user_login_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Add reset password link.
  $url_object = Url::fromRoute('user.pass');
  $form['actions']['password_reset_link'] = [
    '#type' => 'link',
    '#url' => $url_object,
    '#title' => new TranslatableMarkup('Forgot password?'),
    '#attributes' => [
      'class' => ['user-reset-password-link'],
    ],
  ];
}
function  buildinggreen_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if($form_id=='user_pass'){
      // Add login link.
  $url_object = Url::fromRoute('user.login');
  $form['actions']['user_login_link'] = [
    '#type' => 'link',
    '#url' => $url_object,
    '#title' => new TranslatableMarkup('Log in'),
    '#attributes' => [
      'class' => ['user_login_link'],
    ],
  ];
    $form['actions']['submit'] ['#value']= t('E-mail new password');

  }

}
